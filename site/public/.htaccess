# Своя страница 404 вместо заглушки хостинга
ErrorDocument 404 /404.html

# Принудительный HTTPS (Beget: nginx-фронт + Apache-бэкенд, Apache видит http внутри)
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Перенаправление с www на без www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# === Редиректы старого сайта (WordPress) ===

# Дубли адресов: /index.html и /blog/index.html → короткие версии (canonical указывает на них)
RewriteRule ^index\.html$ https://smartsolutions.today/ [R=301,L]
RewriteRule ^blog/index\.html$ https://smartsolutions.today/blog/ [R=301,L]

# /portfolio/* → главная (на новом сайте портфолио на главной)
RewriteRule ^portfolio/?$ https://smartsolutions.today/ [R=301,L]
RewriteRule ^portfolio/.+ https://smartsolutions.today/ [R=301,L]

# /category/kejsy/* → /cases/ (кейсы переехали)
RewriteRule ^category/kejsy/?$ https://smartsolutions.today/cases/arhgrille.html [R=301,L]
RewriteRule ^category/kejsy/.+ https://smartsolutions.today/cases/arhgrille.html [R=301,L]

# /category/blog/* → 410 Gone (блога больше нет)
RewriteRule ^category/blog(/.*)?$ - [G]

# Остальные старые WordPress-пути → 410 Gone
RewriteRule ^category(/.*)?$ - [G]
RewriteRule ^wp-admin(/.*)?$ - [G]
RewriteRule ^wp-includes(/.*)?$ - [G]
RewriteRule ^wp-content(/.*)?$ - [G]
RewriteRule ^wp-login\.php$ - [G]
RewriteRule ^xmlrpc\.php$ - [G]
RewriteRule ^feed(/.*)?$ - [G]
RewriteRule ^trackback(/.*)?$ - [G]
RewriteRule ^author(/.*)?$ - [G]
RewriteRule ^tag(/.*)?$ - [G]
RewriteRule ^page/\d+ - [G]
RewriteRule ^comments(/.*)?$ - [G]
# Старые адреса вида /?p=123 (проверяем QUERY_STRING: RewriteRule путь не видит)
RewriteCond %{QUERY_STRING} (^|&)p=\d+(&|$)
RewriteRule ^ - [G]

# Кеширование статики
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Безопасность: запрет листинга директорий
Options -Indexes

# Безопасность: запрет доступа к служебным файлам
# manifest.json — исключение: его запрашивает браузер (иконка сайта на Android)
<FilesMatch "^(?!manifest\.json$).+\.(md|json|jsonl)$">
    Require all denied
</FilesMatch>

# Запрет доступа к send.php напрямую (только POST); в сборке файла нет — правило на случай ручной выгрузки
<Files "send.php">
    <RequireAll>
        Require method POST OPTIONS
    </RequireAll>
</Files>
