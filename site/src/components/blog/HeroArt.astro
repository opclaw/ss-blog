---
// Живой арт в «шапке» статьи: схема по теме материала, которая отвечает на нажатия.
// Шесть вариантов: flow (заявка → ИИ → человек), doc (документ и проверка), calc (цифры и рубли),
// nodes (агент и его системы), chat (диалог), steps (этапы процесса).
// Каждый вариант разбит на шаги: нажатие на шаг (или на точку под схемой) подсвечивает его
// и меняет подпись внизу — читатель сам разбирает схему, как мини-демо.
// Без JS схема остаётся статичной и читаемой: подписи шагов видны, подпись — первый шаг.
interface Props {
  variant?: 'flow' | 'doc' | 'calc' | 'nodes' | 'chat' | 'steps';
  labels?: string[];
  notes?: string[];
}
const { variant = 'flow', labels = [], notes = [] } = Astro.props;
const l = (i: number) => labels[i] ?? '';

const DEFAULT_NOTES: Record<string, string[]> = {
  flow: [
    'Заявка приходит в форму, почту или мессенджер — здесь начинается отсчёт времени',
    'ИИ разбирает заявку: тип, срочность, данные клиента, черновик ответа',
    'Человек проверяет и отправляет — решение и ответственность остаются за ним',
  ],
  doc: [
    'Скан, PDF или фото: ИИ вытаскивает текст даже из плохого качества',
    'Реквизиты, суммы, НДС — ИИ сверяет с базой и помечает расхождения',
    'Человек проверяет помеченное и подписывает — ручного ввода больше нет',
  ],
  calc: [
    'Часы на процесс за месяц: считаем по журналу задач или хронометражу',
    'Ставка часа вместе с налогами — от неё зависит вся экономия',
    'Экономия в месяц и срок окупаемости: решение принимают по ним',
  ],
  nodes: [
    'Агент — в центре: он ведёт задачу и сам решает, куда обратиться',
    'CRM: карточка клиента, история обращений, статус сделки',
    'Почта и мессенджеры: черновики ответов и цепочки переписки',
    '1С и таблицы: документы, счета, статусы оплат',
    'Человек: подтверждает значимые шаги и отвечает за результат',
  ],
  chat: [
    'Клиент спрашивает своими словами — без меню и кнопок',
    'Ответ собирается по вашей базе знаний: цены, сроки, условия',
    'Сложный вопрос уходит человеку — вместе с контекстом и историей',
  ],
  steps: [
    'Описываем процесс как есть: шаги, время, объём работы',
    'Собираем данные и настраиваем контур: что ИИ делает сам, а где стоп',
    'Пилот на реальных задачах с проверкой каждого результата',
    'Считаем эффект и решаем: масштабировать, доработать или остановить',
  ],
};
const note = (i: number) => notes[i] ?? DEFAULT_NOTES[variant]?.[i] ?? l(i);

const wrap = (s: string, max = 13) => {
  const t = (s || '').trim();
  if (t.length <= max) return [t];
  const lines: string[] = [];
  let cur = '';
  for (const w of t.split(' ')) {
    if (!cur) cur = w;
    else if ((cur + ' ' + w).length <= max) cur += ' ' + w;
    else { lines.push(cur); cur = w; }
  }
  if (cur) lines.push(cur);
  return lines.length > 2 ? [lines[0], lines.slice(1).join(' ')] : lines;
};
const dy = (n: number, i: number) => (i - (n - 1) / 2) * 12;
const F = 'JetBrains Mono, ui-monospace, monospace';
const INK = '#101014', DIM = '#5E5E68', MUTE = '#6C6C78', LINE = '#E4E4DE', LINE2 = '#D2D2CA';
const ACC = '#00D9FF', ACCT = '#0A7392', GREEN = '#0E9F6E', GREEN_INK = '#0B7A57', GREEN_BG = '#E3F5EE', RED = '#C2410C', AMBER = '#B45309';
const stepCount = { flow: 3, doc: 3, calc: 3, nodes: 5, chat: 3, steps: 4 }[variant];
---
<div class="bl-hero-live" data-hero={variant}>
  <svg class="bl-hero-art" viewBox="0 0 420 300" aria-hidden="true">
    {variant === 'flow' && (
      <g>
        {/* бегущая точка идёт ПОД карточками: видна в промежутках между этапами
            и не наезжает на подписи (раньше проходила по тексту карточек) */}
        <circle r="4" fill={ACC}><animateMotion dur="4s" repeatCount="indefinite" path="M70 150h292" /></circle>
        <g class="h-step" data-hs="0" data-note={note(0)}>
          <rect x="18" y="118" width="104" height="64" rx="10" fill="#fff" stroke={LINE2} />
          <text x="70" y="150" text-anchor="middle" font-family={F} font-size="10" fill={INK}>{wrap(l(0), 12).map((t, i, a) => <tspan x="70" dy={i === 0 ? dy(a.length, i) : 12}>{t}</tspan>)}</text>
          <text x="70" y="176" text-anchor="middle" font-family={F} font-size="10" fill={MUTE}>вход</text>
        </g>
        <path d="M122 150h40" stroke={LINE2} stroke-width="1.5" />
        <path d="M158 146l6 4-6 4" fill="none" stroke={LINE2} stroke-width="1.5" />
        <g class="h-step" data-hs="1" data-note={note(1)}>
          <rect x="164" y="106" width="118" height="88" rx="12" fill="#fff" stroke={ACC} stroke-width="1.5" />
          <text x="223" y="128" text-anchor="middle" font-family={F} font-size="10" fill={ACCT}>{wrap(l(1), 13).map((t, i) => <tspan x="223" dy={i === 0 ? 0 : 12}>{t}</tspan>)}</text>
          <g stroke={LINE} stroke-width="4" stroke-linecap="round">
            <path d="M186 158h74M186 170h54M186 182h64" />
          </g>
          <rect class="kit-hero-scan" x="176" y="108" width="94" height="3" rx="1.5" fill={ACC} />
        </g>
        <path d="M282 150h40" stroke={LINE2} stroke-width="1.5" />
        <path d="M318 146l6 4-6 4" fill="none" stroke={LINE2} stroke-width="1.5" />
        <g class="h-step" data-hs="2" data-note={note(2)}>
          <rect x="316" y="112" width="92" height="76" rx="10" fill={GREEN_BG} stroke={GREEN} />
          <text x="362" y="150" text-anchor="middle" font-family={F} font-size="10" fill={GREEN_INK}>{wrap(l(2), 12).map((t, i, a) => <tspan x="362" dy={i === 0 ? dy(a.length, i) : 12}>{t}</tspan>)}</text>
          <text x="362" y="176" text-anchor="middle" font-family={F} font-size="10" fill={GREEN_INK}>решение</text>
        </g>
      </g>
    )}

    {variant === 'doc' && (
      <g>
        <g class="h-step" data-hs="0" data-note={note(0)}>
          <rect x="110" y="16" width="200" height="228" rx="10" fill="#fff" stroke={LINE2} />
          <g stroke={LINE} stroke-width="6" stroke-linecap="round">
            <path d="M140 60h140M140 84h120M140 108h140M140 132h100M140 156h140M140 180h130M140 204h90M140 228h140" />
          </g>
        </g>
        <g class="h-step" data-hs="1" data-note={note(1)}>
          <path d="M140 108h140" stroke={RED} stroke-opacity=".35" stroke-width="10" stroke-linecap="round" />
          <path d="M140 180h130" stroke={AMBER} stroke-opacity=".35" stroke-width="10" stroke-linecap="round" />
          <g font-family={F} font-size="11" fill={DIM}>
            <path d="M296 108h34" stroke={RED} stroke-width="1.5" />
            <circle cx="336" cy="108" r="11" fill="#fff" stroke={RED} stroke-width="1.5" />
            <text x="336" y="112" text-anchor="middle" fill={RED} font-size="12">!</text>
            <path d="M286 180h44" stroke={AMBER} stroke-width="1.5" />
            <circle cx="336" cy="180" r="11" fill="#fff" stroke={AMBER} stroke-width="1.5" />
            <text x="336" y="184" text-anchor="middle" fill={AMBER} font-size="12">?</text>
          </g>
        </g>
        <g class="h-step" data-hs="2" data-note={note(2)}>
          <g font-family={F} font-size="11" fill={DIM}>
            <circle cx="80" cy="222" r="16" fill={GREEN_BG} stroke={GREEN} stroke-width="1.5" />
            <text x="80" y="227" text-anchor="middle" fill={GREEN_INK} font-size="12">✓</text>
            <path d="M96 222h36" stroke={GREEN} stroke-width="1.5" stroke-dasharray="3 3" />
          </g>
        </g>
        <g font-family={F} font-size="10">
          {[[20, RED, l(0)], [150, AMBER, l(1)], [286, GREEN, l(2)]].map(([x, c, label], i) => (
            // зеркало шага: подсвечивается вместе с ним, но подпись и нажатие берёт основной блок
            <g class="h-mirror" data-hs={String(i)}>
              <circle cx={+x + 4} cy="268" r="4" fill={c as string} />
              <text x={+x + 14} y="272" fill={DIM}>{wrap(String(label), 14).join(' ')}</text>
            </g>
          ))}
        </g>
        <rect class="kit-hero-scan" x="104" y="16" width="212" height="3" rx="1.5" fill={ACC} />
      </g>
    )}

    {variant === 'calc' && (
      <g>
        <line x1="60" y1="230" x2="360" y2="230" stroke={LINE2} stroke-width="1.5" />
        <g class="h-step" data-hs="0" data-note={note(0)}>
          <rect x="86" y="120" width="58" height="110" rx="6" fill="#F1F1EC" stroke={LINE} />
          <text x="115" y="108" text-anchor="middle" font-family={F} font-size="11" fill={DIM}>{l(0)}</text>
        </g>
        <g class="h-step" data-hs="1" data-note={note(1)}>
          <rect x="182" y="176" width="58" height="54" rx="6" fill={GREEN_BG} stroke={GREEN} />
          <text x="211" y="164" text-anchor="middle" font-family={F} font-size="11" fill={GREEN_INK}>{l(1)}</text>
        </g>
        <g class="h-step" data-hs="2" data-note={note(2)}>
          <path d="M244 150h44" stroke={LINE2} stroke-width="1.5" stroke-dasharray="4 4" />
          <rect x="278" y="64" width="96" height="60" rx="10" fill="#fff" stroke={ACC} stroke-width="1.5" />
          <text x="326" y="90" text-anchor="middle" font-family={F} font-size="16" fill={ACCT}>{l(2)}</text>
          <text x="326" y="110" text-anchor="middle" font-family={F} font-size="10" fill={MUTE}>экономия / мес</text>
          <circle cx="326" cy="150" r="18" fill="#fff" stroke={ACC} />
          <text x="326" y="156" text-anchor="middle" font-family={F} font-size="14" fill={ACCT}>₽</text>
        </g>
      </g>
    )}

    {variant === 'nodes' && (
      <g>
        <g class="h-step" data-hs="0" data-note={note(0)}>
          <circle cx="210" cy="150" r="44" fill="#fff" stroke={ACC} stroke-width="1.5" />
          <text x="210" y="147" text-anchor="middle" font-family={F} font-size="11" fill={ACCT}>{l(0)}</text>
          <text x="210" y="164" text-anchor="middle" font-family={F} font-size="10" fill={MUTE}>агент</text>
          <circle class="kit-hero-scan" cx="210" cy="150" r="52" fill="none" stroke={ACC} stroke-opacity=".5" />
        </g>
        {[[74, 66], [346, 66], [74, 234], [346, 234]].map(([x, y], i) => (
          <g class="h-step" data-hs={String(i + 1)} data-note={note(i + 1)}>
            <path d={`M${x + (x < 210 ? 46 : -46)} ${y + (y < 150 ? 18 : -18)}L${210 + (x < 210 ? -30 : 30)} ${150 + (y < 150 ? -22 : 22)}`}
                  stroke={LINE2} stroke-width="1.2" stroke-dasharray="4 4" fill="none" />
            <rect x={x - 46} y={y - 22} width="92" height="44" rx="9" fill="#fff" stroke={LINE} />
            <text x={x} y={y + 5} text-anchor="middle" font-family={F} font-size="10" fill={INK}>{wrap(l(i + 1), 13).map((t, j, a) => <tspan x={x} dy={j === 0 ? dy(a.length, j) : 12}>{t}</tspan>)}</text>
          </g>
        ))}
      </g>
    )}

    {variant === 'chat' && (
      <g>
        <g class="h-step" data-hs="0" data-note={note(0)}>
          <rect x="52" y="52" width="196" height="58" rx="14" fill="#fff" stroke={LINE} />
          <text x="72" y="86" font-family={F} font-size="10" fill={INK}>{wrap(l(0), 26).join(' ')}</text>
        </g>
        <g class="h-step" data-hs="1" data-note={note(1)}>
          <rect x="172" y="126" width="196" height="58" rx="14" fill={GREEN_BG} stroke={GREEN} />
          <text x="192" y="160" font-family={F} font-size="10" fill={GREEN_INK}>{wrap(l(1), 26).join(' ')}</text>
        </g>
        <g class="h-step" data-hs="2" data-note={note(2)}>
          <rect x="52" y="200" width="196" height="58" rx="14" fill="#fff" stroke={ACC} />
          <text x="72" y="234" font-family={F} font-size="10" fill={ACCT}>{wrap(l(2), 26).join(' ')}</text>
          {/* курсор «печатает» — внутри пузыря, а не висящей точкой в пустоте */}
          <circle cx="228" cy="246" r="3.5" fill={ACC}><animate attributeName="opacity" values="1;.2;1" dur="1.8s" repeatCount="indefinite" /></circle>
        </g>
      </g>
    )}

    {variant === 'steps' && (
      <g>
        <path d="M60 168h300" stroke={LINE} stroke-width="2" />
        {[0, 1, 2, 3].map((i) => (
          <g class="h-step" data-hs={String(i)} data-note={note(i)}>
            <circle cx={60 + i * 100} cy="168" r="17" fill="#fff" stroke={i === 0 ? ACC : LINE2} stroke-width="1.5" />
            <text x={60 + i * 100} y="173" text-anchor="middle" font-family={F} font-size="12" fill={i === 0 ? ACCT : DIM}>{i + 1}</text>
            <text x={60 + i * 100} y="206" text-anchor="middle" font-family={F} font-size="10" fill={DIM}>{wrap(l(i), 13).map((t, j, a) => <tspan x={60 + i * 100} dy={j === 0 ? dy(a.length, j) : 12}>{t}</tspan>)}</text>
          </g>
        ))}
        <circle class="kit-hero-scan" cx="60" cy="168" r="26" fill="none" stroke={ACC} stroke-opacity=".5" />
      </g>
    )}
  </svg>

  <p class="bl-hero-cap">
    <span data-hero-cap>{note(0)}</span>
    <em data-hero-hint>нажимайте этапы — покажем, что происходит</em>
  </p>
  <div class="bl-hero-dots">
    {Array.from({ length: stepCount }).map((_, i) => (
      <button type="button" class="bl-hero-dot" data-hd={String(i)} aria-label={`Этап ${i + 1}`}></button>
    ))}
  </div>
</div>
