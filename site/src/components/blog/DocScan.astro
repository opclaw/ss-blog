---
// Вычитка документа: слева договор с подсвеченными пунктами, справа — полный реестр находок.
// Переосмыслено 2026-09-28 по замечанию владельца («правая колонка выглядела незаконченной»):
// реестр виден ЦЕЛИКОМ сразу, включая находку «чего ИИ не увидел» — она и есть главная мысль
// блока: модель подсвечивает риски, но последнее слово и то, что вне текста, — за человеком.
// Кнопка «Проверить договор» запускает подсветку в тексте заново (прогресс, а не раскрытие).
// Клик по находке раскрывает объяснение — одно за раз, чтобы список оставался реестром.
interface Clause { text: string; n?: string }            // в text риск помечается [[...]]
interface Find { n: string; level: 'high' | 'mid' | 'human'; title: string; note: string }
interface Props { fig: number; title: string; docTitle: string; clauses: Clause[]; finds: Find[]; note?: string; autorun?: boolean }
const { fig, title, docTitle, clauses, finds, note, autorun = false } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const lv = { high: 'высокий риск', mid: 'проверить', human: 'вне текста' };
const machine = finds.filter((f) => f.level !== 'human');
const high = machine.filter((f) => f.level === 'high').length;
const summary = `${machine.length} находок: ${high} высокий риск · ${machine.length - high} проверить`;
const human = finds.filter((f) => f.level === 'human').length;
const humanLine = human ? `+${human} риск вне текста — его видит только человек` : '';
const render = (c: Clause) => esc(c.text).replace(/\[\[(.+?)\]\]/g, (_m, t) => `<span class="kit-risk ${finds.find((f) => f.n === c.n)?.level ?? 'mid'}" data-n="${c.n}">${t}<sup>${c.n}</sup></span>`);
---
<figure class="kit kit-scan" data-kit="scan" data-autorun={autorun ? '' : undefined}>
  <figcaption class="kit-cap"><b>Рис. {fig}</b>{title}<em>иллюстрация, условия вымышленные</em></figcaption>
  <div class="kit-scan-grid">
    <div class="kit-doc">
      <div class="kit-scan-line" aria-hidden="true"></div>
      <p class="kit-doc-h">{docTitle}</p>
      {clauses.map((c, i) => <p><span class="n">{i + 1}.</span><Fragment set:html={render(c)} /></p>)}
    </div>
    <div class="kit-side">
      <div class="kit-side-top">
        <button type="button" class="kit-btn" data-scan-run>Проверить договор</button>
        <span class="kit-count" aria-live="polite"><b data-scan-count>0</b>из {machine.length} находок</span>
      </div>
      <p class="kit-scan-sum" data-scan-sum>{summary}</p>
      <p class="kit-scan-hint">Нажмите на находку — раскроем, чем она опасна. Или на подсвеченный пункт в договоре.</p>
      {humanLine && <p class="kit-scan-human-line" data-human-line>{humanLine}</p>}
      <ol class="kit-finds">
        {finds.map((f) => (
          <li class={f.level} data-n={f.n}>
            <button type="button" class="kit-find-head" aria-controls={`find-note-${f.n}`}>
              <span class="kit-find-txt">
                <span class="lv">{f.level === 'human' ? lv.human : `№${f.n} · ${lv[f.level]}`}</span>
                <b class="kit-find-t">{f.title}</b>
              </span>
              <span class="kit-chev" aria-hidden="true"></span>
            </button>
            <div class="kit-find-note" id={`find-note-${f.n}`}>{f.note}</div>
          </li>
        ))}
      </ol>
    </div>
  </div>
  {note && <p class="kit-foot">{note}</p>}
</figure>
