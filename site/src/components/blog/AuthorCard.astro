---
// Карточка автора: кто написал материал и куда написать.
// Одна точка правды — имя, роль и описание в src/data/site.ts (AUTHOR), Telegram в CONTACTS.
// Отсюда же берут текст все 21 статья блога — и «старый» макет (styles.css), и «лист» (article.css).
// Видна на всех экранах: на широких — отдельной колонкой справа, на узких — в потоке после статьи.
// Тёмный блок на светлом листе — так же, как блок с промптом: акцент, а не «ещё один серый блок».
// Стили внутри компонента и на явных значениях: карточка выглядит одинаково в обоих макетах,
// не завися от токенов темы конкретной страницы.
import { AUTHOR, CONTACTS } from '../../data/site';

interface Props {
  /** подпись над именем */
  label?: string;
  /** необязательная строка-пояснение под карточкой */
  note?: string;
}
const { label = 'Автор', note } = Astro.props;
---
<aside class="author-card" aria-label={label}>
  <p class="author-card-label">{label}</p>
  <p class="author-card-name">{AUTHOR.name}</p>
  <p class="author-card-bio">{AUTHOR.bio}</p>
  <a class="author-card-tg" href={CONTACTS.telegram} target="_blank" rel="noopener">
    <svg width="22" height="22" aria-hidden="true"><use href="/icons.svg#icon-telegram" /></svg>
    <span class="author-card-tg-txt">
      <span class="author-card-tg-label">Telegram</span>
      <span class="author-card-tg-value">{CONTACTS.telegramHandle}</span>
    </span>
  </a>
  {note && <p class="author-card-note">{note}</p>}
</aside>

<style>
  .author-card {
    background: #08080d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .author-card-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #00d9ff;
    margin: 0;
  }
  .author-card-name {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #f5f5f7;
    margin: 0;
  }
  .author-card-bio {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(245, 245, 247, 0.6);
    margin: 0;
  }
  .author-card-tg {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(0, 217, 255, 0.08);
    border: 1px solid rgba(0, 217, 255, 0.22);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .author-card-tg:hover {
    background: rgba(0, 217, 255, 0.15);
    border-color: rgba(0, 217, 255, 0.4);
  }
  .author-card-tg:focus-visible {
    outline: 2px solid #00d9ff;
    outline-offset: 2px;
  }
  .author-card-tg svg {
    flex: none;
    color: #00d9ff;
  }
  .author-card-tg-txt {
    min-width: 0;
  }
  .author-card-tg-label {
    display: block;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 245, 247, 0.6);
  }
  .author-card-tg-value {
    display: block;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: #f5f5f7;
    margin-top: 5px;
  }
  .author-card-note {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(245, 245, 247, 0.6);
    margin: 4px 0 0;
  }
</style>
