---
// Карточка автора: кто написал материал и куда написать.
// Одна точка правды — имя, роль и описание в src/data/site.ts (AUTHOR), Telegram в CONTACTS.
// Отсюда же берут текст все 21 статья блога — и «старый» макет (styles.css), и «лист» (article.css).
// Видна на всех экранах: на широких — отдельной колонкой справа, на узких — в потоке после статьи.
// Карточка умеет обе темы через переменные --ac-*: на светлом «листе» подставляются светлые
// значения (правило .bl-author в article.css), в тёмных статьях работает тёмная по умолчанию.
// Так один компонент не спорит ни с бумагой, ни с тёмным фоном.
import { AUTHOR, CONTACTS } from '../../data/site';

interface Props {
  /** подпись над именем */
  label?: string;
  /** необязательная строка-пояснение под карточкой */
  note?: string;
  /** тема: dark (по умолчанию, тёмные статьи) или light (светлый «лист») */
  theme?: 'dark' | 'light';
}
const { label = 'Автор', note, theme = 'dark' } = Astro.props;
---
<aside class:list={['author-card', theme === 'light' && 'author-card--light']} aria-label={label}>
  <p class="author-card-label">{label}</p>
  <p class="author-card-name">{AUTHOR.name}</p>
  <p class="author-card-bio">{AUTHOR.bio}</p>
  <a class="author-card-tg" href={CONTACTS.telegram} target="_blank" rel="noopener">
    <svg width="22" height="22" aria-hidden="true"><use href="/icons.svg#icon-telegram" /></svg>
    <span class="author-card-tg-txt">
      <span class="author-card-tg-label">Telegram</span>
      <span class="author-card-tg-value">{CONTACTS.telegramHandle}</span>
    </span>
  </a>
  {note && <p class="author-card-note">{note}</p>}
</aside>

<style>
  .author-card {
    /* Тёмная тема — по умолчанию; светлая подставляется через --ac-* на светлом листе. */
    --ac-bg: #0e0e14;
    --ac-line: rgba(255, 255, 255, 0.08);
    --ac-label: #00d9ff;
    --ac-name: #f5f5f7;
    --ac-bio: rgba(245, 245, 247, 0.6);
    --ac-tg-bg: rgba(0, 217, 255, 0.08);
    --ac-tg-line: rgba(0, 217, 255, 0.22);
    --ac-tg-bg-hover: rgba(0, 217, 255, 0.15);
    --ac-tg-line-hover: rgba(0, 217, 255, 0.4);
    --ac-icon: #00d9ff;
    --ac-tg-label: rgba(245, 245, 247, 0.6);
    --ac-tg-value: #f5f5f7;
    --ac-focus: #00d9ff;
    background: var(--ac-bg);
    border: 1px solid var(--ac-line);
    border-radius: 18px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* Светлая тема для светлого «листа»: белая поверхность с тонкой линией — как остальные блоки листа.
     Контрасты проверены: подпись 4.63:1, био 6.41:1, текст в кнопке 17.2:1 (WCAG AA и выше). */
  .author-card--light {
    --ac-bg: #ffffff;
    --ac-line: #e4e4de;
    --ac-label: #0a7ea4;
    --ac-name: #101014;
    --ac-bio: #5e5e68;
    --ac-tg-bg: #e3f7fc;
    --ac-tg-line: rgba(10, 126, 164, 0.28);
    --ac-tg-bg-hover: #d6f1fa;
    --ac-tg-line-hover: rgba(10, 126, 164, 0.55);
    --ac-icon: #0a7ea4;
    --ac-tg-label: #5e5e68;
    --ac-tg-value: #101014;
    --ac-focus: #0a7ea4;
  }
  .author-card-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ac-label);
    margin: 0;
  }
  .author-card-name {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ac-name);
    margin: 0;
  }
  .author-card-bio {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ac-bio);
    margin: 0;
  }
  .author-card-tg {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--ac-tg-bg);
    border: 1px solid var(--ac-tg-line);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .author-card-tg:hover {
    background: var(--ac-tg-bg-hover);
    border-color: var(--ac-tg-line-hover);
  }
  .author-card-tg:focus-visible {
    outline: 2px solid var(--ac-focus);
    outline-offset: 2px;
  }
  .author-card-tg svg {
    flex: none;
    color: var(--ac-icon);
  }
  .author-card-tg-txt {
    min-width: 0;
  }
  .author-card-tg-label {
    display: block;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ac-tg-label);
  }
  .author-card-tg-value {
    display: block;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ac-tg-value);
    margin-top: 5px;
  }
  .author-card-note {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ac-bio);
    margin: 4px 0 0;
  }
</style>
