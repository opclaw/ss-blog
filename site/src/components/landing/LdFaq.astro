---
// Частые вопросы раздела. Видимый FAQ совпадает со схемой FAQPage (проверяет seo-audit):
// вопросы и ответы приходят из того же массива, что и JSON-LD страницы.
interface QA {
  q: string;
  a: string;
}
interface Props {
  items: QA[];
}
const { items } = Astro.props;
import { typo } from '../../data/typo';
---

<div class="ld-faq">
  {items.map((f) => (
    <details>
      <summary>{typo(f.q)}</summary>
      <p>{typo(f.a)}</p>
    </details>
  ))}
</div>
