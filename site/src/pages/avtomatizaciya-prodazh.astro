---
// Автоматизация продаж: коммерческий раздел-посадочная (в корне, схема Service).
// Структура раздела, а не статьи: оффер с ценой → проблема → цена медленного ответа →
// что автоматизируем → инструмент расчёта → замер до/после → порядок работ → цены →
// готовность → разборы по теме → FAQ → контакты. Ни оглавления, ни автора, ни «времени чтения».
// От статьи /blog/ii-dlya-prodazh.html отличается интентом: там «где теряются заявки»,
// здесь — «сколько стоит, за какой срок и что даёт в рублях».
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
import { assetV } from '../data/asset-version';
import Funnel from '../components/blog/Funnel.astro';
import Calc from '../components/blog/Calc.astro';
import Aba from '../components/blog/Aba.astro';
import Timeline from '../components/blog/Timeline.astro';
import Checklist from '../components/blog/Checklist.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import HeroPanel from '../components/landing/HeroPanel.astro';
import LdSection from '../components/landing/LdSection.astro';
import LdCards from '../components/landing/LdCards.astro';
import LdPrices from '../components/landing/LdPrices.astro';
import LdFaq from '../components/landing/LdFaq.astro';
import LdLinks from '../components/landing/LdLinks.astro';

// Пример для расчёта: отдел из 4 менеджеров, 300 заявок в месяц,
// конверсия в сделку 10 % (30 сделок), чек 60 000 ₽, маржа 20 %.
const mgIn = [
  { id: 'n', label: 'Заявок в месяц', min: 50, max: 2000, step: 50, value: 300 },
  { id: 't', label: 'Минут на заявку вручную', min: 5, max: 60, step: 5, value: 25, unit: ' мин' },
  { id: 'p', label: 'ИИ снимает рутины', min: 10, max: 90, step: 5, value: 55, unit: ' %' },
  { id: 'rate', label: 'Час менеджера', min: 300, max: 2000, step: 1, value: 714, unit: ' ₽' },
  { id: 'lost', label: 'Без быстрого ответа', min: 5, max: 50, step: 5, value: 20, unit: ' %' },
  { id: 'save', label: 'Из них возвращаем в работу', min: 5, max: 60, step: 5, value: 15, unit: ' %' },
  { id: 'c', label: 'Средний чек', min: 10000, max: 500000, step: 10000, value: 60000, unit: ' ₽' },
  { id: 'm', label: 'Маржа', min: 5, max: 60, step: 5, value: 20, unit: ' %' },
  { id: 'sup', label: 'Поддержка в месяц', min: 5000, max: 100000, step: 5000, value: 25000, unit: ' ₽' },
  { id: 'setup', label: 'Пилот и внедрение разово', min: 50000, max: 500000, step: 10000, value: 250000, unit: ' ₽' },
];
const mgRows = [
  { expr: 'n*t/60', label: 'Часов рутины в месяц', unit: 'ч', dig: 0 },
  { expr: 'n*t/60*p/100', label: 'Часов снимает ИИ', unit: 'ч', dig: 1 },
  { expr: 'n*t/60*p/100*rate', label: 'Экономия на времени', unit: '₽/мес', dig: 0 },
  { expr: 'n*lost/100', label: 'Заявок без быстрого ответа', unit: 'шт', dig: 0 },
  { expr: 'n*lost/100*save/100', label: 'Возвращено в работу', unit: 'сделок', dig: 1 },
  { expr: 'n*lost/100*save/100*c*m/100', label: 'Прибыль с них', unit: '₽/мес', dig: 0 },
  { expr: 'n*t/60*p/100*rate + n*lost/100*save/100*c*m/100 - sup', label: 'Чистый эффект', unit: '₽/мес', dig: 0 },
  { expr: 'setup/Math.max(1, n*t/60*p/100*rate + n*lost/100*save/100*c*m/100 - sup)', label: 'Окупаемость', unit: 'мес', dig: 1, cap: 120 },
];
// Пороги те же, что во всех калькуляторах блога: 4 / 9 месяцев.
const mgVerdict = {
  expr: 'setup/Math.max(1, n*t/60*p/100*rate + n*lost/100*save/100*c*m/100 - sup)',
  levels: [
    { max: 4, text: 'До 4 месяцев — делать: поток заявок окупает внедрение быстро.', tone: 'go' },
    { max: 9, text: '4–9 месяцев — обсуждаемо: считайте на большем потоке или берите базовый пилот.', tone: 'check' },
    { max: 999, text: 'Больше 9 месяцев — не делаем: при таком потоке расходы не отобьются.', tone: 'stop' },
  ],
};

const mgTl = [
  { label: 'Аудит', who: 'человек', text: 'Разбираем воронку, считаем часы на заявку и долю потерянных обращений. Аудит бесплатный и ни к чему не обязывает: если автоматизация не окупится, мы скажем об этом сразу.' },
  { label: 'Пилот', who: 'ИИ+человек', text: 'Берём один процесс — обычно первичный ответ или дожим — и запускаем на 2–4 недели. До старта фиксируем метрики, чтобы потом было с чем сравнивать.' },
  { label: 'Замер', who: 'человек', text: 'Сравниваем время ответа, долю обработанных заявок и сделки до и после. Считаем ошибки ассистента: сколько он делает и сколько ловит менеджер.' },
  { label: 'Масштабирование', who: 'ИИ+человек', text: 'Расширяем на другие каналы и этапы воронки. Дальше — сопровождение: обновление базы знаний, контроль качества, отчёт раз в месяц.' },
];

// Замер до/после — те же 300 заявок и 30 сделок, что в расчёте выше.
const abaRows = [
  { label: 'Время первого ответа', before: 45, after: 1, unit: 'мин', note: 'в рабочие часы; ночью и в выходные заявка вообще ждала утра' },
  { label: 'Заявок обработано без менеджера', before: 0, after: 55, unit: '%', note: 'ассистент квалифицирует и передаёт готовую карточку' },
  { label: 'Сделок в месяц', before: 30, after: 39, unit: 'шт', note: '30 своих + 9 возвращённых из заявок без ответа' },
  { label: 'Выручка отдела', before: 1800000, after: 2340000, unit: '₽', note: '39 × 60 000 ₽; по марже 20 % это +108 000 ₽ прибыли' },
];

const problems = [
  { n: '01', t: 'Скорость первого ответа', d: 'Заявка ждёт менеджера, а интерес остывает быстрее, чем освобождается человек. На цифрах примера: ответ через 45 минут вместо минуты стоит до 20 сделок в месяц — это предел при идеальной скорости, а не обещание.' },
  { n: '02', t: 'Квалификация', d: 'Менеджер тратит одинаковое время на заявку с бюджетом и на «просто узнать цену». Пока он разбирается, горячий клиент остывает.' },
  { n: '03', t: 'Дожим', d: 'Клиент сказал «надо подумать» — и про него забыли, потому что напоминать некому и некогда. Follow-up делается от случая к случаю.' },
  { n: '04', t: 'Ввод в CRM', d: 'Данные из переписки переносят вручную вечером — или не переносят. Руководитель видит воронку, которой нет.' },
  { n: '05', t: 'Контроль', d: 'Сделка сорвалась молча: никто не знает, на каком шаге и почему. Разбор диалогов начинается, когда клиент уже написал плохой отзыв.' },
];

const automations = [
  { t: 'Первичный ответ и квалификация', d: 'Отвечает за минуты в любое время суток, задаёт два-три уточняющих вопроса и передаёт менеджеру готовую карточку: контакт, что нужно, бюджет, срок, откуда пришли.', note: 'менеджер ведёт диалог с подготовленным клиентом', noteLabel: 'Человек' },
  { t: 'Скоринг и приоритизация', d: 'Заявки раскладываются по приоритету: срочные и с бюджетом — первыми, «посмотреть цены» — в очередь на рассылку.', note: 'правила приоритета утверждает руководитель', noteLabel: 'Человек' },
  { t: 'Follow-up и дожим', d: 'Цепочка шагов по реакции клиента: ответил — продолжаем диалог, молчит — останавливаемся. Не рассылка «ну вы оплатите?» каждую неделю.', note: 'менеджер подключается на возражениях и торге', noteLabel: 'Человек' },
  { t: 'Данные в CRM без ручного ввода', d: 'То, что клиент сообщил в переписке, попадает в карточку: не надо копировать вечером и надеяться, что менеджер вспомнит.', note: 'сделку и следующий шаг закрывает менеджер', noteLabel: 'Человек' },
  { t: 'Контроль качества', d: 'Диалоги разбираются по чек-листу, руководитель видит, где сделка остановилась и что ответил ассистент. Это не «прослушка», а список мест, где теряются деньги.', note: 'решения по людям и процессам — за руководителем', noteLabel: 'Человек' },
];

const plans = [
  {
    name: 'Аудит',
    price: '0 ₽',
    term: '1–2 дня',
    items: [
      'Разбираем воронку и считаем экономику на ваших цифрах',
      'Называем метрики, по которым будем мерить эффект',
      'Если не окупится — говорим сразу, до оплаты',
    ],
  },
  {
    name: 'Пилот',
    price: '50 000–150 000 ₽',
    term: '2–4 недели',
    featured: true,
    items: [
      'Один процесс: первичный ответ или дожим',
      'Подключаем каналы: мессенджеры, почта, форма сайта, CRM',
      'Замер до и после — на ваших заявках и сделках',
      'Обучаем команду и передаём базу знаний',
    ],
  },
  {
    name: 'Внедрение',
    price: 'от 200 000 ₽',
    term: 'объём и срок — после пилота',
    items: [
      'Расширяем на другие каналы и этапы воронки',
      'Интеграции с CRM и учётными системами',
      'Регламенты, права доступа, контроль качества',
    ],
  },
  {
    name: 'Сопровождение',
    price: 'по объёму',
    term: 'ежемесячно',
    items: [
      'Обновление базы знаний и сценариев',
      'Разбор диалогов и контроль качества',
      'Отчёт раз в месяц',
    ],
  },
];

const checkItems = [
  'Заявки приходят в доступные каналы: Telegram, WhatsApp, почта, форма сайта, CRM.',
  'Есть хотя бы 50 заявок в месяц — на меньшем потоке экономия часов не перекроет расходы.',
  'Описана воронка: из чего в что превращается заявка и где она сейчас теряется.',
  'Понятны типовые вопросы клиентов и возражения — из них собирается база знаний ассистента.',
  'Назначен человек, который первые 2–3 недели будет проверять ответы ассистента.',
  'Есть кому смотреть цифры: время ответа, доля обработанных заявок, сделки.',
  'Руководитель готов начать с одного процесса, а не автоматизировать весь отдел сразу.',
];

const links = [
  { href: '/blog/ii-dlya-prodazh.html', meta: 'разбор', title: 'ИИ для продаж: где теряются заявки и что с этим делать' },
  { href: '/blog/kak-poschitat-effekt-ot-ii-do-pilota.html', meta: 'методика', title: 'Как посчитать эффект от ИИ до пилота: формула и пример' },
  { href: '/blog/skolko-stoit-vnedrenie-ii.html', meta: 'стоимость', title: 'Сколько стоит внедрение ИИ: из чего складывается цена' },
  { href: '/ai.html', meta: 'направление', title: 'Внедрение ИИ в процессы: как мы работаем' },
];

const faq = [
  {
    q: 'Сколько стоит автоматизация продаж?',
    a: 'Аудит бесплатный. Пилот на одном процессе — от 50 000 до 150 000 ₽ в зависимости от числа каналов и интеграций. Полноценное внедрение — от 200 000 ₽, поддержка обсуждается отдельно. Точная сумма называется после аудита, когда понятен объём.',
  },
  {
    q: 'Как быстро будет эффект?',
    a: 'Первый эффект на первичных ответах виден в первые дни: ассистент начинает отвечать сразу после подключения. По сделкам судить раньше чем через месяц нельзя — нужен сопоставимый объём заявок до и после.',
  },
  {
    q: 'Что если не окупится?',
    a: 'Для этого и есть пилот: за 2–4 недели видно, сходится ли экономика на ваших цифрах. Если нет — останавливаемся, вы платите только за пилот. Годовой договор до замера эффекта мы не предлагаем.',
  },
  {
    q: 'ИИ будет общаться с клиентами вместо менеджеров?',
    a: 'На первичной обработке — да: ответить, уточнить параметры, передать карточку. Продажу, переговоры и возражения ведёт менеджер. Ассистент снимает рутину, а не ответственность.',
  },
  {
    q: 'Нужно ли менять CRM?',
    a: 'Не обязательно. Ассистент подключается поверх того, что уже есть: мессенджеры, почта, CRM или таблица. Если в вашей CRM есть импорт или API, данные уходят туда автоматически; если нет — карточка формируется в таблице.',
  },
  {
    q: 'Безопасно ли передавать нам переписку и базу клиентов?',
    a: 'Схему выбираем под ваши требования: закрытый контур или российские модели, которые не отправляют данные за пределы РФ. С кем и как работаем с персональными данными, фиксируем до старта — это часть договора.',
  },
];

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://smartsolutions.today/' },
      { '@type': 'ListItem', position: 2, name: 'AI-направление', item: 'https://smartsolutions.today/ai.html' },
      { '@type': 'ListItem', position: 3, name: 'Автоматизация продаж', item: 'https://smartsolutions.today/avtomatizaciya-prodazh.html' },
    ],
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Автоматизация продаж с ИИ',
    serviceType: 'Автоматизация процессов отдела продаж',
    provider: { '@type': 'Organization', name: 'Smart Solutions', url: 'https://smartsolutions.today/' },
    areaServed: 'RU',
    description:
      'Автоматизация одного процесса отдела продаж с замером эффекта: первичный ответ, квалификация, дожим, CRM. Пилот 2–4 недели, расчёт в часах менеджеров и сделках.',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }),
];
---

<Base
  jsonLd={jsonLd}
  title="Автоматизация продаж: цена, сроки, расчёт — Smart Solutions"
  description="Автоматизация отдела продаж: считаем эффект в рублях до договора. Пилот 2–4 недели — от 50 000 ₽, внедрение — от 200 000 ₽. Расчёт на ваших цифрах."
  path="/avtomatizaciya-prodazh.html"
  ogDescription="Сначала считаем: сколько заявок теряется на скорости ответа и что это стоит в рублях. Потом — пилот на 2–4 недели."
  active="ai"
  mainWrap={false}
  skipTo="#main-content"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`/blog-assets/article.css?v=${assetV('/blog-assets/article.css')}`} />
    <link rel="stylesheet" href={`/blog-assets/kit.css?v=${assetV('/blog-assets/kit.css')}`} />
  </Fragment>

  {/* bl-dark — тёмные токены для интерактива и схем: раздел живёт в тёмной теме сайта */}
  <main class="bl-dark" id="main-content">
    <LandingHero
      label="Услуга · AI-направление"
      title="Автоматизация продаж: цена, сроки и расчёт эффекта"
      lead="Ассистент отвечает на заявки за минуты в любое время суток, квалифицирует и передаёт менеджеру готовую карточку. Эффект считаем в рублях до договора, а пилот идёт 2–4 недели с замером до и после."
      prices={['Аудит — 0 ₽', 'Пилот 2–4 недели — 50 000–150 000 ₽', 'Внедрение — от 200 000 ₽']}
      actions={[
        { href: '#contacts', label: 'Обсудить задачу' },
        { href: '#raschet', label: 'Посчитать окупаемость', kind: 'outline' },
      ]}
    >
      <HeroPanel slot="aside"
        head="заявка · отдел продаж"
        time="цикл 2 мин"
        steps={[
          { t: 'Заявка из формы, почты или мессенджера', d: 'Ночью и в выходные — в любое время' },
          { t: 'Ответ за минуты и два уточняющих вопроса', d: 'Клиент ещё не ушёл к конкуренту' },
          { t: 'Готовая карточка в CRM: контакт, задача, срок', d: 'Менеджер открывает сделку, а не переписку' },
        ]}
        foot="Человек подтверждает значимые шаги — агент не действует молча"
      />
    </LandingHero>

    <LdSection id="problema" label="Что теряется" title="Где отдел продаж теряет деньги"
      sub="Пять точек, которые мы проверяем на аудите. Обычно работают две-три сразу."
    >
      <LdCards items={problems} />
    </LdSection>

    <LdSection id="cena-otveta" alt label="Цена медленного ответа" title="Из 300 заявок до сделок доходит не всё"
      sub="Пример отдела из четырёх менеджеров: 300 заявок в месяц, ответ через 45 минут, чек 60 000 ₽, маржа 20 %."
    >
      <div class="ld-stats">
        <div class="ld-stat"><b>60</b><span>заявок в месяц не дождались быстрого ответа — каждый пятый</span></div>
        <div class="ld-stat"><b>9</b><span>из них возвращаем в работу на пилоте: осторожная доля 15 %</span></div>
        <div class="ld-stat"><b>108 000 <em>₽/мес</em></b><span>прибыль с возвращённых сделок при марже 20 %</span></div>
      </div>

      <figure class="fig bl-fig">
        <figcaption><span>Как считаем</span><span>Из 300 заявок до сделок доходит не всё</span></figcaption>
        <svg viewBox="0 0 720 210" class="fig-svg" role="img" aria-label="Из 300 заявок 60 не дождались быстрого ответа, 9 возвращаемы в работу, это 108 000 рублей прибыли в месяц">
          <text x="10" y="24" class="f-label">ЗАЯВОК В МЕСЯЦ</text>
          <rect x="10" y="34" width="660" height="30" class="fg-plate"/>
          <text x="20" y="54" class="f-mono">300 · весь поток отдела из четырёх менеджеров</text>
          <text x="10" y="92" class="f-label">НЕ ДОЖДАЛИСЬ БЫСТРОГО ОТВЕТА</text>
          <rect x="10" y="102" width="132" height="30" class="fg-warn-plate"/>
          <text x="150" y="122" class="f-mono">60 · каждый пятый обращается не туда</text>
          <text x="10" y="160" class="f-label">ИЗ НИХ ВОЗВРАЩАЕМ В РАБОТУ</text>
          <rect x="10" y="170" width="20" height="30" class="fg-acc-plate"/>
          <text x="38" y="190" class="f-mono f-acc">9 сделок · 15 % из потерянных</text>
        </svg>
      </figure>

      <p class="ld-after">
        Девять сделок при чеке 60 000 ₽ и марже 20 % — это <b>108 000 ₽ прибыли в месяц</b> из заявок,
        за привлечение которых вы уже заплатили. Цифры примера: свои подставьте в расчёте ниже.
      </p>
    </LdSection>

    <LdSection id="chto-automatiziruem" label="Что делаем" title="Что именно мы автоматизируем"
      sub="Пять процессов. На пилоте берём один — тот, где потери виднее всего. Дальше у каждого пункта указано, что остаётся за человеком."
    >
      <LdCards items={automations} />
    </LdSection>

    <LdSection id="raschet" alt label="Инструмент" title="Посчитайте окупаемость на своих цифрах"
      sub="Ползунки работают без заявки: подставьте свои числа — модель пересчитает. Никакой внешней статистики, только следствия введённых цифр."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Funnel fig={1} title="Сколько сделок стоит медленный первый ответ" n={300} t={45} half={60} k={17} c={60000}
          note="Модель считает по вашим же числам: сколько заявок в месяц, через сколько минут отвечаете сейчас, за сколько минут интерес остывает вдвое и какая конверсия из диалога в сделку. В деньгах — по выручке, без вычета маржи: для прибыли умножьте на вашу маржу (в расчёте ниже она учитывается отдельно). На цифрах примера предел — +20 сделок, но отвечать за минуту на все заявки не получится: в расчёте ниже берём осторожную долю, 15 % из заявок без быстрого ответа — это 9 сделок." />

        <Calc fig={2} title="Экономия часов и возвращённые сделки" inputs={mgIn} cols={2}
          main={{ expr: 'n*t/60*p/100*rate + n*lost/100*save/100*c*m/100', label: 'Эффект до вычета расходов', unit: '₽/мес', dig: 0 }}
          rows={mgRows} verdict={mgVerdict}
          note="Два потока. Первый — время: заявки × минуты на обработку × час менеджера × долю, которую снимает ассистент. Второй — сделки: доля заявок без быстрого ответа × какая часть возвращается в работу × чек × маржа. Из суммы вычитаем поддержку, разовые затраты делим на остаток — это окупаемость. По умолчанию стоит полный путь «пилот + внедрение» — 250 000 ₽, минимальная вилка из прайса ниже. Доля возврата 15 % — осторожное допущение, а не обещание: на пилоте её и проверяем. Окупаемость больше 120 месяцев — показываем «—»." />
      </div>

      <p class="ld-after">
        Обратите внимание на пропорцию: экономия на часах — около 49 000 ₽ в месяц, а возвращённые сделки —
        108 000 ₽. Автоматизация продаж окупается не тем, что менеджеры начинают работать быстрее,
        а тем, что заявки перестают теряться.
      </p>
    </LdSection>

    <LdSection id="zamer" label="Замер до и после" title="Как выглядит результат пилота"
      sub="Тот же отдел, те же каналы и та же реклама. Цифры примера — на пилоте фиксируем ваши."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Aba fig={3} title="Один процесс, четыре метрики" rows={abaRows} caption="замер на одних и тех же задачах"
          verdict="Главная строка — не время ответа, а сделки: +9 в месяц при той же рекламе и том же штате."
          note="Время ответа и доля обработанных заявок измеряются автоматически. Сделки считаем за полный месяц до и полный месяц после: на более коротком отрезке разница тонет в обычном разбросе." />
      </div>
    </LdSection>

    <LdSection id="process" alt label="Порядок работ" title="Как мы работаем: от аудита до сопровождения"
      sub="Четыре шага. Пилот — 2–4 недели, метрики фиксируем до старта, деньги — после замера."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Timeline fig={4} title="От аудита до сопровождения" stages={mgTl} />
      </div>
    </LdSection>

    <LdSection id="ceny" label="Цены и сроки" title="Сколько это стоит и когда платить"
      sub="Точную сумму называем после аудита, когда понятен объём. Годовой договор до замера эффекта не предлагаем."
    >
      <LdPrices plans={plans} ctaLabel="Обсудить" />
      <p class="ld-after">
        Считать окупаемость можно самому — ползунки в разделе «Посчитайте окупаемость» работают без заявки.
        Разбор того, из чего складывается цена, — в статье <a href="/blog/skolko-stoit-vnedrenie-ii.html">«Сколько стоит внедрение ИИ»</a>.
      </p>
    </LdSection>

    <LdSection id="gotovnost" alt label="Готовность" title="Что должно быть готово к пилоту"
      sub="Семь пунктов. Отметьте, что уже есть: шкала покажет, можно ли начинать."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Checklist fig={5} title="Готовность отдела к пилоту" items={checkItems}
          note="Отмечайте честно: если не хватает заявок или некому проверять ассистента, пилот это покажет, но деньги будут потрачены зря." />
      </div>
    </LdSection>

    <LdSection id="chitat" label="По теме" title="Разборы и расчёты"
      sub="Блог отвечает «что такое» и «как», раздел — «сколько, за какой срок и что это даёт»."
    >
      <LdLinks items={links} />
    </LdSection>

    <LdSection id="faq" alt label="Вопросы" title="Частые вопросы">
      <LdFaq items={faq} />
    </LdSection>

    <section id="contacts" class="section section-cta">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Разберём вашу воронку</h2>
          <p class="text-secondary cta-subtitle">Покажем, где теряются заявки и окупится ли автоматизация. Аудит бесплатный.</p>
          <ContactCards />
        </div>
      </div>
    </section>

    <Fragment slot="tail">
      <script is:inline src={`/blog-assets/kit.js?v=${assetV('/blog-assets/kit.js')}`}></script>
    </Fragment>
  </main>
</Base>
