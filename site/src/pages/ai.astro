---
// Сгенерировано из legacy/version-4/ai.html (tools/import_legacy.py). Дальше правим здесь.
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
---
<Base
  title={"Внедрение ИИ в процессы компании — Smart Solutions"}
  description={"Внедряем искусственный интеллект в ежедневные процессы: заявки, документы, база знаний, отчёты. Сначала считаем эффект в часах и рублях — потом внедряем."}
  path="/ai.html"
  ogDescription={"Нейросеть — 20% результата. Остальные 80 — процесс. Считаем эффект до внедрения, в часах и рублях."}
  active="ai"
  effects
>
<style is:inline slot="head">
    /* AI page additions: receipt, scheme, pilot progress */
    .ai-hero { padding-top: clamp(140px, 18vh, 200px); padding-bottom: clamp(80px, 10vh, 130px); }
    .ai-hero-layout {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(320px, 5fr);
      gap: clamp(32px, 5vw, 80px);
      align-items: center;
    }
    .ai-hero-content { max-width: 720px; }
    .ai-hero-title {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(2.5rem, 5.4vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -0.032em;
      line-height: 1.04;
      margin: 22px 0 30px;
    }
    .ai-hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }

    .receipt {
      background: var(--bg-elevated);
      border: 1px solid var(--border-hover);
      border-radius: var(--radius);
      font-family: var(--font-mono);
      transform: rotate(0.8deg);
      max-width: 460px;
      justify-self: end;
      width: 100%;
      overflow: hidden;
      transition: box-shadow var(--transition), transform var(--transition);
    }
    .receipt:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.35); transform: rotate(0deg); }
    .receipt-head {
      padding: 14px 18px;
      border-bottom: 1px dashed var(--border);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
    }
    .receipt-head span:first-child { color: var(--accent); }
    .receipt-body { padding: 10px 0; }
    .receipt-row {
      display: grid;
      grid-template-columns: 92px 1fr;
      gap: 14px;
      padding: 8px 18px;
      font-size: 0.78rem;
      line-height: 1.5;
    }
    .receipt-key { color: var(--muted); }
    .receipt-row--sum { border-top: 1px dashed var(--border); margin-top: 6px; padding-top: 12px; }
    .receipt-row--sum .receipt-val { color: var(--green); font-weight: 500; }
    .receipt-foot {
      padding: 12px 18px 16px;
      border-top: 1px dashed var(--border);
      font-size: 0.68rem;
      color: var(--muted);
      letter-spacing: 0.02em;
    }

    .scheme {
      border: 1px solid var(--border);
      background: var(--bg-elevated);
      border-radius: var(--radius);
      padding: clamp(18px, 2.6vw, 36px);
      position: relative;
      overflow: hidden;
    }
    .scheme::before {
      content: "";
      position: absolute;
      top: 10px; left: 10px; right: 10px; bottom: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      pointer-events: none;
    }
    .scheme-cap {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 8px;
      position: relative;
    }
    .scheme-cap span:first-child { color: var(--accent); }
    .scheme-svg { width: 100%; height: auto; display: block; position: relative; }
    .scheme .draw { stroke-dasharray: var(--len, 1000); stroke-dashoffset: var(--len, 1000); }
    .scheme.drawn .draw { stroke-dashoffset: 0; transition: stroke-dashoffset 1.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .scheme.drawn .draw.d2 { transition-delay: 0.25s; }
    .scheme.drawn .draw.d3 { transition-delay: 0.5s; }
    .scheme.drawn .draw.d4 { transition-delay: 0.75s; }
    .scheme .fade-el { opacity: 0; transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
    .scheme.drawn .fade-el { opacity: 1; }
    .scheme.drawn .fade-el.f2 { transition-delay: 0.4s; }
    .scheme.drawn .fade-el.f3 { transition-delay: 0.8s; }
    .scheme.drawn .fade-el.f4 { transition-delay: 1.15s; }
    .sc-label { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.04em; fill: var(--fg); }
    .sc-mono { font-family: var(--font-mono); font-size: 11.5px; fill: var(--secondary); }
    .sc-dim { fill: var(--muted); font-size: 11px; }
    .sc-accent { fill: var(--accent); font-size: 11px; letter-spacing: 0.06em; }
    .sc-note { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.08em; fill: var(--accent); }
    .sc-inv { fill: #08080D; }
    .scheme-legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(16px, 3vw, 40px);
      padding-top: 16px;
      border-top: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--secondary);
      position: relative;
      text-align: center;
    }
    .scheme-legend b { color: var(--accent); font-weight: 500; margin-right: 6px; }

    .ai-formula {
      max-width: none;
    }
    .ai-formula-label {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--muted);
      letter-spacing: 0.08em;
      display: block;
      margin-bottom: 20px;
    }
    .ai-formula-eq {
      font-family: var(--font-mono);
      font-size: clamp(1.25rem, 2.9vw, 2.3rem);
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: -0.01em;
      margin: 0;
    }
    .ai-formula-accent { color: var(--accent); }
    .ai-formula-note {
      margin-top: 26px;
      font-size: clamp(0.98rem, 1.3vw, 1.12rem);
      color: var(--secondary);
      max-width: 560px;
      line-height: 1.6;
    }

    .ai-weeks-wrap { position: relative; }
    .ai-weeks-progress {
      position: absolute;
      left: 0;
      top: 0;
      height: 2px;
      width: 0;
      background: var(--accent);
      transition: width 0.15s linear;
      z-index: 2;
    }

    .ai-emphasis {
      margin-top: 44px;
      font-family: 'Manrope', sans-serif;
      font-size: clamp(1.3rem, 2.2vw, 1.8rem);
      font-weight: 700;
      letter-spacing: -0.018em;
      line-height: 1.25;
      max-width: 720px;
    }
    .ai-emphasis strong { color: var(--accent); font-weight: 800; }

    .ai-refuse-list { margin-top: 10px; }
    .ai-refuse {
      display: flex;
      gap: 18px;
      align-items: flex-start;
      padding: 22px 0;
      border-bottom: 1px solid var(--border);
    }
    .ai-refuse:first-child { border-top: 1px solid var(--border); }
    .ai-refuse-marker {
      flex-shrink: 0;
      width: 12px;
      height: 12px;
      margin-top: 6px;
      border: 2px solid rgba(239, 68, 68, 0.6);
      border-radius: 50%;
      position: relative;
    }
    .ai-refuse-marker::after,
    .ai-refuse-marker::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 12px;
      height: 2px;
      background: rgba(239, 68, 68, 0.7);
      transform-origin: center;
    }
    .ai-refuse-marker::after { transform: translate(-50%, -50%) rotate(-45deg); }
    .ai-refuse-marker::before { transform: translate(-50%, -50%) rotate(45deg); }
    .ai-refuse p {
      margin: 0;
      font-size: clamp(1rem, 1.4vw, 1.15rem);
      line-height: 1.55;
      color: var(--fg);
      max-width: 760px;
    }
    .ai-refuse s { text-decoration-color: rgba(239, 68, 68, 0.5); text-decoration-thickness: 2px; }
    .ai-fit-note {
      margin-top: 40px;
      padding: clamp(22px, 3vw, 34px);
      border: 1px solid var(--border-hover);
      border-radius: var(--radius);
      background: var(--card-bg);
    }
    .ai-fit-note p {
      margin: 0;
      font-size: clamp(1.02rem, 1.4vw, 1.2rem);
      line-height: 1.6;
      color: var(--secondary);
      max-width: 820px;
    }

    .ai-serif { font-style: normal; font-weight: 800; color: var(--accent); letter-spacing: -0.02em; }

    @media (max-width: 900px) {
      .ai-hero-layout { grid-template-columns: 1fr; }
      .receipt { justify-self: start; transform: none; max-width: 100%; }
      .ai-hero-actions .btn { width: 100%; justify-content: space-between; }
      .scheme-cap { flex-direction: column; gap: 6px; }
      .scheme-legend { flex-direction: column; gap: 8px; }
      .ai-formula-eq { font-size: clamp(1.05rem, 5.4vw, 1.5rem); }
      .ai-week { grid-template-columns: 1fr; gap: 8px; padding: 22px 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .scheme .draw { stroke-dashoffset: 0 !important; transition: none !important; }
      .packet { opacity: 0 !important; }
      .receipt { transform: none !important; }
    }
  
  /* ===== Формула + график окупаемости: 2-кол. ===== */
    .ai-formula-grid {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
      gap: clamp(24px, 4vw, 56px);
      align-items: start;
    }
    @media (max-width: 880px) {
      .ai-formula-grid { grid-template-columns: 1fr !important; }
    }
    .ai-payback {
      padding: 18px 20px 16px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.015);
      opacity: 1 !important;
      transform: none !important;
    }
    .ai-payback-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 8px;
    }
    .ai-payback-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.04em;
    }
    .ai-payback-meta {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--secondary);
    }
    .ai-payback-svg {
      width: 360px;
      max-width: 100%;
      height: 200px;
      display: block;
      margin: 0 auto;
    }
    @media (max-width: 880px) {
      .ai-payback-svg { width: 100%; }
    }
    .ai-payback-svg .ax-tick {
      font-family: var(--font-mono);
      font-size: 8px;
      fill: rgba(255, 255, 255, 0.45);
    }
    .ai-payback-svg .ax-label {
      font-family: var(--font-mono);
      font-size: 8px;
      fill: rgba(255, 255, 255, 0.55);
    }
    .ai-payback-svg .ax-callout {
      font-family: var(--font-mono);
      font-size: 9px;
      fill: var(--accent);
      font-weight: 600;
    }
    .ai-payback-svg .ax-legend {
      font-family: var(--font-mono);
      font-size: 8px;
      fill: rgba(255, 255, 255, 0.55);
    }
    .ai-payback-foot {
      font-size: 0.78rem;
      color: var(--secondary);
      margin-top: 6px;
      line-height: 1.45;
    }
    .ai-payback-stat {
      color: var(--accent);
      font-weight: 700;
      font-family: var(--font-mono);
    }
  </style>
  <section class="section ai-hero" id="main-content">
    <div class="container">
      <div class="ai-hero-layout">
        <div class="ai-hero-content">
          <p class="label fade-in">AI-направление Smart Solutions</p>

          <h1 class="ai-hero-title fade-in fade-in-d1">
            Вам не нужен ИИ.<br>
            <span class="text-accent">Вам нужны 20 часов команды в неделю.</span>
          </h1>

          <p class="text-secondary fade-in fade-in-d2" style="max-width:560px;">
            Внедряем искусственный интеллект в ежедневную работу компании:
            заявки, документы, база знаний, отчёты. Сначала считаем эффект
            в часах и рублях. Потом — и только потом — внедряем.
          </p>

          <div class="ai-hero-actions fade-in fade-in-d3">
            <a href="#contacts" class="btn btn-primary btn-shimmer">
              Обсудить процесс
              <svg width="18" height="18"><use href="/icons.svg#icon-arrow-right"/></svg>
            </a>
            <a href="#audit" class="btn btn-outline">Как считаем эффект</a>
          </div>
        </div>

        <aside class="receipt fade-in fade-in-d3" aria-label="Пример результата аудита">
          <div class="receipt-head">
            <span>Аудит процесса</span>
            <span>№ 001</span>
          </div>
          <div class="receipt-body">
            <div class="receipt-row">
              <span class="receipt-key">процесс</span>
              <span class="receipt-val">обработка входящих заявок</span>
            </div>
            <div class="receipt-row">
              <span class="receipt-key">сейчас</span>
              <span class="receipt-val">14 ч/нед — ручные ответы</span>
            </div>
            <div class="receipt-row">
              <span class="receipt-key">после ИИ</span>
              <span class="receipt-val">3 ч/нед — проверка черновиков</span>
            </div>
            <div class="receipt-row receipt-row--sum">
              <span class="receipt-key">эффект</span>
              <span class="receipt-val">≈ 44 ч/мес возвращается команде</span>
            </div>
            <div class="receipt-row receipt-row--sum">
              <span class="receipt-key">в деньгах</span>
              <span class="receipt-val">≈ 88 000 ₽/мес при ставке 2 000 ₽/ч</span>
            </div>
          </div>
          <div class="receipt-foot">цифры — иллюстрация формата; ваши считаем на аудите</div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===== fig. 01: SVG SCHEME ===== -->
  <section class="section section-alt section-border-top">
    <div class="container">
      <figure class="scheme" id="scheme" aria-label="Схема работы ИИ-контура">
        <figcaption class="scheme-cap">
          <span>fig. 01</span>
          <span>Контур обработки заявки — как это устроено</span>
        </figcaption>
        <svg viewBox="0 0 1200 480" class="scheme-svg" role="img">
          <defs>
            <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10z" fill="#00D9FF"/>
            </marker>
          </defs>

          <line x1="80" y1="46" x2="1120" y2="46" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="80" y1="40" x2="80" y2="52" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="1120" y1="40" x2="1120" y2="52" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <text x="600" y="36" text-anchor="middle" class="sc-mono sc-dim fade-el">цикл: от заявки до ответа — 2 минуты вместо 40</text>

          <rect x="80" y="170" width="170" height="130" fill="var(--bg-elevated)" stroke="#00D9FF" stroke-width="1.25" class="draw" style="--len:600"/>
          <text x="165" y="200" text-anchor="middle" class="sc-label fade-el f2">ЗАЯВКА</text>
          <text x="165" y="222" text-anchor="middle" class="sc-mono fade-el f2">форма · почта</text>
          <text x="165" y="240" text-anchor="middle" class="sc-mono fade-el f2">мессенджер</text>
          <text x="165" y="272" text-anchor="middle" class="sc-note fade-el f2">①</text>

          <line id="flowA" x1="250" y1="235" x2="330" y2="235" stroke="#00D9FF" stroke-width="1.25" marker-end="url(#arr)" class="draw d2" style="--len:80"/>

          <rect x="340" y="120" width="380" height="240" fill="none" stroke="#00D9FF" stroke-width="1.25" stroke-dasharray="6 4" class="fade-el f2"/>
          <text x="530" y="106" text-anchor="middle" class="sc-mono sc-accent fade-el f2">ПЕРИМЕТР БЕЗОПАСНОСТИ · данные не покидают контур</text>

          <rect x="370" y="150" width="320" height="52" fill="var(--bg-elevated)" stroke="#00D9FF" stroke-width="1" class="draw d2" style="--len:744"/>
          <text x="530" y="172" text-anchor="middle" class="sc-label fade-el f3">КЛАССИФИКАЦИЯ</text>
          <text x="530" y="192" text-anchor="middle" class="sc-mono fade-el f3">тип запроса · срочность · тон</text>

          <rect x="370" y="216" width="320" height="52" fill="var(--bg-elevated)" stroke="#00D9FF" stroke-width="1" class="draw d3" style="--len:744"/>
          <text x="530" y="238" text-anchor="middle" class="sc-label fade-el f3">БАЗА ЗНАНИЙ</text>
          <text x="530" y="258" text-anchor="middle" class="sc-mono fade-el f3">регламенты · цены · кейсы</text>

          <rect x="370" y="282" width="320" height="52" fill="#00D9FF" class="draw d4" style="--len:744"/>
          <text x="530" y="304" text-anchor="middle" class="sc-label sc-inv fade-el f4">ЧЕРНОВИК ОТВЕТА</text>
          <text x="530" y="324" text-anchor="middle" class="sc-mono sc-inv fade-el f4">со ссылкой на источник</text>

          <text x="530" y="392" text-anchor="middle" class="sc-note fade-el f4">②</text>

          <line id="flowB" x1="720" y1="235" x2="800" y2="235" stroke="#00D9FF" stroke-width="1.25" marker-end="url(#arr)" class="draw d3" style="--len:80"/>

          <rect x="810" y="170" width="170" height="148" fill="var(--bg-elevated)" stroke="#00D9FF" stroke-width="1.25" class="draw d3" style="--len:636"/>
          <!-- голова: круг -->
          <circle cx="895" cy="200" r="10" fill="none" stroke="#00D9FF" stroke-width="1.5"/>
          <!-- шея: короткая вертикаль -->
          <line x1="895" y1="210" x2="895" y2="218" stroke="#00D9FF" stroke-width="1.5"/>
          <!-- плечи + тело: трапеция с заливкой (бюст) -->
          <path d="M875 222 Q895 215 915 222 L921 250 Q895 254 869 250 Z" fill="rgba(0,217,255,0.06)" stroke="#00D9FF" stroke-width="1.5"/>
          <text x="895" y="282" text-anchor="middle" class="sc-label fade-el f4">ПРОВЕРКА</text>
          <text x="895" y="306" text-anchor="middle" class="sc-mono fade-el f4">менеджер</text>
          <text x="985" y="148" text-anchor="middle" class="sc-note fade-el f4">③</text>

          <line x1="980" y1="235" x2="1060" y2="235" stroke="#00D9FF" stroke-width="1.25" marker-end="url(#arr)" class="draw d4" style="--len:80"/>

          <rect x="1070" y="170" width="50" height="130" fill="var(--fg)" class="fade-el f4"/>
          <text x="1095" y="228" text-anchor="middle" class="sc-label sc-inv fade-el f4" transform="rotate(-90 1095 235)">ОТВЕТ</text>

          <line x1="80" y1="420" x2="720" y2="420" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="80" y1="414" x2="80" y2="426" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="720" y1="414" x2="720" y2="426" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <text x="400" y="446" text-anchor="middle" class="sc-mono sc-dim fade-el">автоматически — без участия человека</text>

          <line x1="810" y1="420" x2="980" y2="420" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="810" y1="414" x2="810" y2="426" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <line x1="980" y1="414" x2="980" y2="426" stroke="var(--muted)" stroke-width="0.75" class="fade-el"/>
          <text x="895" y="446" text-anchor="middle" class="sc-mono sc-dim fade-el">контроль человеком</text>

          <line x1="165" y1="262" x2="165" y2="300" stroke="var(--muted)" stroke-width="0.5" stroke-dasharray="2 2" class="fade-el f2"/>
          <text x="165" y="316" text-anchor="middle" class="sc-mono sc-dim fade-el f2">вход из любого канала</text>
          <line x1="895" y1="318" x2="895" y2="334" stroke="var(--muted)" stroke-width="0.5" stroke-dasharray="2 2" class="fade-el f4"/>
          <text x="895" y="346" text-anchor="middle" class="sc-mono sc-dim fade-el f4">решение — за человеком</text>

          <!-- бегущий пакет: чистый SVG animateMotion, без JS -->
          <circle r="4" fill="#00D9FF" opacity="1">
            <animateMotion
              dur="4s"
              repeatCount="indefinite"
              path="M250,235 L800,235 L895,235 L980,235 L1055,235"/>
            <animate attributeName="r" values="4;5;4" dur="0.9s" repeatCount="indefinite"/>
          </circle>
        </svg>
        <div class="scheme-legend">
          <span><b>①</b> заявка из любого канала</span>
          <span><b>②</b> ИИ готовит черновик внутри контура</span>
          <span><b>③</b> человек проверяет и отправляет</span>
        </div>
      </figure>
    </div>
      </section>

  <!-- ===== FORMULA ===== -->
