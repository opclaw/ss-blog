<!-- Inline scripts for new interactions only -->
  <script is:inline>
(function() {
      const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scheme draw-on-scroll (packet handled by SVG animateMotion)
      const scheme = document.getElementById('scheme');
      if (scheme) {
        const schemeObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              scheme.classList.add('drawn');
              obs.disconnect();
            }
          });
        }, { threshold: 0.25 });
        schemeObserver.observe(scheme);
      }

      // Pilot weeks progress line
      const weeks = document.getElementById('aiWeeks');
      const wp = document.getElementById('weeksProgress');
      if (weeks && wp && !prefersReduced) {
        const updateProgress = () => {
          const r = weeks.getBoundingClientRect();
          const visible = Math.min(Math.max(innerHeight * 0.7 - r.top, 0), r.height);
          wp.style.width = (visible / r.height * 100) + '%';
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }
    })();
  </script>
