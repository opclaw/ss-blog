---
// Посадочная 2/3: ИИ-ассистент для сайта.
// Кластер Wordstat: «чат бот для сайта» 548, «чат боты для бизнеса» 846,
// «ии чат бот для бизнеса» 94, «ии чат бот для сайта» 57, «создание чат ботов для сайтов» 54.
// Ключ «ии для сайта» (16 213) сознательно не берём: по подсказкам там ищут генераторы
// сайтов, а не ассистента — это другой интент и чужая аудитория.
// Макет — «светлый лист» статьи, страница сама ставит <main>, поэтому mainWrap={false}.
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
import Funnel from '../components/blog/Funnel.astro';
import Calc from '../components/blog/Calc.astro';
import Aba from '../components/blog/Aba.astro';
import Timeline from '../components/blog/Timeline.astro';
import Checklist from '../components/blog/Checklist.astro';
import AuthorCard from '../components/blog/AuthorCard.astro';
import HeroArt from '../components/blog/HeroArt.astro';
import { assetV } from '../data/asset-version';
import { readSuffix } from '../data/reading-time';

const toc = [
  { id: 'sec-1', label: 'Где сайт теряет обращения' },
  { id: 'sec-2', label: 'Что умеет ассистент' },
  { id: 'sec-3', label: 'Считаем эффект: обращения в деньги' },
  { id: 'sec-4', label: 'Замер до и после на одном трафике' },
  { id: 'sec-5', label: 'Как проходит внедрение' },
  { id: 'sec-6', label: 'Стоимость и сроки' },
  { id: 'sec-7', label: 'Что нужно от вас для старта' },
  { id: 'sec-8', label: 'Смотрите также' },
  { id: 'sec-faq', label: 'Частые вопросы' },
];

// Все значения по умолчанию кратны шагу ползунка: иначе браузер подменит значение
// и расчёт на странице разойдётся с текстом (ловили трижды на статьях).
const mgIn = [
  { id: 'v', label: 'Визитов в месяц', min: 1000, max: 100000, step: 1000, value: 20000 },
  { id: 'ask', label: 'Пишут в чат или форму', min: 1, max: 20, step: 1, value: 4, unit: ' %' },
  { id: 'lost', label: 'Остаются без ответа', min: 10, max: 90, step: 5, value: 40, unit: ' %' },
  { id: 'back', label: 'Ассистент возвращает в диалог', min: 5, max: 60, step: 5, value: 35, unit: ' %' },
  { id: 'lead', label: 'Из диалога в сделку', min: 2, max: 40, step: 1, value: 12, unit: ' %' },
  { id: 'c', label: 'Средний чек', min: 5000, max: 500000, step: 5000, value: 40000, unit: ' ₽' },
  { id: 'm', label: 'Маржа', min: 5, max: 60, step: 5, value: 25, unit: ' %' },
  { id: 'sup', label: 'Поддержка в месяц', min: 5000, max: 100000, step: 5000, value: 15000, unit: ' ₽' },
  { id: 'setup', label: 'Пилот и внедрение разово', min: 50000, max: 500000, step: 10000, value: 250000, unit: ' ₽' },
];
const EFFECT = 'v*ask/100*lost/100*back/100*lead/100*c*m/100';
const mgRows = [
  { expr: 'v*ask/100', label: 'Обращений в месяц', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100', label: 'Из них без ответа', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100*back/100', label: 'Возвращает ассистент', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100*back/100*lead/100', label: 'Сделок с них', unit: 'шт', dig: 1 },
  { expr: 'v*ask/100*lost/100*back/100*lead/100*c', label: 'Выручка с них', unit: '₽/мес', dig: 0 },
  { expr: EFFECT, label: 'Прибыль с них', unit: '₽/мес', dig: 0 },
  { expr: `${EFFECT} - sup`, label: 'Чистый эффект', unit: '₽/мес', dig: 0 },
  { expr: `setup/Math.max(1, ${EFFECT} - sup)`, label: 'Окупаемость', unit: 'мес', dig: 1, cap: 120 },
];
// Пороги те же, что во всех калькуляторах блога: 4 / 9 месяцев.
const mgVerdict = {
  expr: `setup/Math.max(1, ${EFFECT} - sup)`,
  levels: [
    { max: 4, text: 'До 4 месяцев — делать: трафик сайта окупает ассистента быстро.', tone: 'go' },
    { max: 9, text: '4–9 месяцев — обсуждаемо: считайте на большем трафике или берите базовый пилот.', tone: 'check' },
    { max: 999, text: 'Больше 9 месяцев — не делаем: при таком трафике расходы не отобьются.', tone: 'stop' },
  ],
};

const mgTl = [
  { label: 'Аудит', who: 'человек', text: 'Разбираем, что спрашивают на сайте, и считаем долю обращений без ответа. Аудит бесплатный и ни к чему не обязывает: если ассистент не окупится, мы скажем об этом сразу.' },
  { label: 'Пилот', who: 'ИИ+человек', text: 'Берём один сценарий — обычно цены, сроки и запись — и запускаем на 2–4 недели. До старта фиксируем метрики, чтобы потом было с чем сравнивать.' },
  { label: 'Замер', who: 'человек', text: 'Сравниваем долю обращений без ответа, время первого ответа и сделки с сайта до и после. Считаем ошибки: сколько диалогов ассистент закрыл сам, а сколько передал менеджеру.' },
  { label: 'Масштабирование', who: 'ИИ+человек', text: 'Расширяем сценарии, подключаем мессенджеры и CRM. Дальше — сопровождение: обновление базы знаний, разбор диалогов, отчёт раз в месяц.' },
];

// Замер до/после — те же 800 обращений и 40 % без ответа, что в расчёте выше.
const abaRows = [
  { label: 'Время первого ответа', before: 45, after: 1, unit: 'мин', note: 'ночью и в выходные обращение вообще ждало утра' },
  { label: 'Доля обращений без ответа', before: 40, after: 26, unit: '%', note: '320 из 800 было, стало 208: остальное забирает ассистент' },
  { label: 'Сделок с сайта в месяц', before: 57.1, after: 70.5, unit: 'шт', note: ' было 57,1 — столько же показывает воронка выше; +13,4 возвращённых' },
  { label: 'Выручка с сайта', before: 2284000, after: 2820000, unit: '₽', note: '70,5 × 40 000 ₽; по марже 25 % это +134 400 ₽ прибыли' },
];

const checkItems = [
  'На сайте понятен объём: хотя бы 1 000 визитов и 50 обращений в месяц.',
  'Типовые вопросы собраны: цены, сроки, доставка, гарантия, как заказать.',
  'Есть база знаний для ответов: прайс, каталог, описание услуг, готовый FAQ.',
  'Понятно, куда уходит обращение: почта, CRM, Telegram ответственного менеджера.',
  'Назначен человек, который первые 2–3 недели читает диалоги и правит базу знаний.',
  'Есть кому смотреть цифры: доля без ответа, время ответа, сделки с сайта.',
  'Руководитель готов начать с одного сценария, а не автоматизировать все вопросы сразу.',
];

const faq = [
  {
    q: 'Сколько стоит ИИ-ассистент для сайта?',
    a: 'Аудит бесплатный. Пилот на одном сценарии — от 50 000 до 150 000 ₽ в зависимости от объёма базы знаний и числа интеграций. Полноценное внедрение — от 200 000 ₽, поддержка обсуждается отдельно. Точная сумма называется после аудита.',
  },
  {
    q: 'Чем он отличается от обычного чат-бота с кнопками?',
    a: 'Обычный бот ведёт по сценарию «нажмите 1, нажмите 2» и теряется на любом нестандартном вопросе. Ассистент отвечает на свободные вопросы по вашей базе знаний: понимает «а сколько будет с доставкой в Казань?», находит ответ в прайсе и отвечает по нему. Сценарии нужны там, где нужен порядок действий — запись, оформление, передача менеджеру.',
  },
  {
    q: 'Не будет ли он выдумывать ответы клиентам?',
    a: 'Ассистент отвечает по вашей базе знаний и не придумывает того, чего в ней нет: если уверенности недостаточно, он уточняет вопрос или передаёт диалог менеджеру. Первые 2–3 недели человек выборочно проверяет диалоги — это условие запуска, а не опция.',
  },
  {
    q: 'Как быстро ассистент заработает на сайте?',
    a: 'Базовый сценарий — цены, сроки, запись — поднимаем за 2–4 недели. Срок зависит от объёма базы знаний и числа интеграций: если ответы собраны, быстрее; если их предстоит писать с нуля, дольше.',
  },
  {
    q: 'Нужен ли свой сервер и что с персональными данными?',
    a: 'Работаем в закрытом контуре или на российских моделях — как удобнее вам. Где живут данные и кто имеет к ним доступ, прописываем в договоре до старта, а не после.',
  },
  {
    q: 'Как поймём, что сработало?',
    a: 'Метрики фиксируем до старта: доля обращений без ответа, время первого ответа, сделки с сайта. Сравниваем полный месяц до и полный месяц после — на коротком отрезке разница тонет в обычном разбросе трафика.',
  },
];

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://smartsolutions.today/' },
      { '@type': 'ListItem', position: 2, name: 'AI-направление', item: 'https://smartsolutions.today/ai.html' },
      { '@type': 'ListItem', position: 3, name: 'ИИ-ассистент для сайта', item: 'https://smartsolutions.today/ii-assistent-dlya-sajta.html' },
    ],
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'ИИ-ассистент для сайта',
    serviceType: 'ИИ-ассистент для обработки обращений с сайта',
    provider: { '@type': 'Organization', name: 'Smart Solutions', url: 'https://smartsolutions.today/' },
    areaServed: 'RU',
    description:
      'ИИ-ассистент на сайт: отвечает на вопросы посетителей по базе знаний компании, квалифицирует обращение и передаёт готовый диалог менеджеру. Пилот 2–4 недели, замер эффекта до и после.',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }),
];
---

<Base
  jsonLd={jsonLd}
  title="ИИ-ассистент для сайта: цена, сроки — Smart Solutions"
  description="ИИ-ассистент для сайта отвечает на вопросы посетителей по вашей базе знаний: цены, сроки, запись. Считаем эффект в рублях до договора. Пилот 2–4 недели — от 50 000 ₽."
  path="/ii-assistent-dlya-sajta.html"
  ogDescription="Посетитель написал в 21:40, менеджер ответит утром — или ответит ассистент через минуту. Сначала считаем, потом запускаем."
  active="ai"
  bodyClass="bl-page"
  mainWrap={false}
  skipTo="#main-content"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`/blog-assets/article.css?v=${assetV('/blog-assets/article.css')}`} />
    <link rel="stylesheet" href={`/blog-assets/kit.css?v=${assetV('/blog-assets/kit.css')}`} />
  </Fragment>

  <main class="bl-sheet" id="main-content">
    <header class="bl-hero">
      <div class="bl-hero-in">
        <div class="bl-hero-txt">
          <p class="bl-kicker">Услуга · AI-направление</p>
          <h1>ИИ-ассистент для сайта: цена, сроки и расчёт эффекта</h1>
          <p class="bl-meta">Один сценарий · 2–4 недели · замер до и после</p>
        </div>

        <HeroArt variant="chat"
          labels={['Посетитель, 21:40: «сколько стоит и когда привезут?»', 'Отвечаю сразу по вашему прайсу и срокам', 'Вопрос не по базе — передаю менеджеру']}
          notes={['Вечер и выходные: оператора нет, посетитель уходит к конкуренту', 'Ассистент отвечает по базе знаний компании, а не выдумывает', 'Менеджер утром открывает готовый диалог и контакт']} />
      </div>
    </header>

    <div class="bl-body">
      <aside class="bl-toc" aria-label="Содержание">
        <p>На странице</p>
        {toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
      </aside>
      <div class="bl-text">
        <details class="bl-toc-m" open><summary>На странице <span class="bl-toc-toggle"></span></summary><ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol></details>

        <p class="bl-intro">Половина обращений с сайта приходит тогда, когда отвечать некому: вечер, выходные, менеджер на встрече. Посетитель задаёт вопрос, не дожидается и уходит к тем, кто ответил. ИИ-ассистент закрывает эту дыру — отвечает по вашей базе знаний в любое время и передаёт менеджеру готовый диалог. Ниже — расчёт на ваших цифрах, цены и порядок работ. Как это устроено изнутри — в разборе <a href="/blog/chto-takoe-ii-agent.html">«Что такое ИИ-агент»</a>.</p>

        <Funnel fig={1} title="Сколько обращений доживает до диалога" n={800} t={45} half={60} k={12} c={40000}
          note="Модель считает по вашим же числам: сколько обращений в месяц, через сколько минут отвечаете сейчас, за сколько минут интерес остывает вдвое и какая конверсия из диалога в сделку. На цифрах примера предел — +38 сделок, но отвечать за минуту на всё не получится: в расчёте ниже берём осторожную долю, 35 % из обращений без ответа — это 13 сделок. Никакой внешней статистики: только следствия введённых цифр." />

        <h2 id="sec-1">Где сайт теряет обращения</h2>
        <p>Пять причин, которые мы проверяем на аудите. Обычно работают две-три сразу.</p>
        <ol>
          <li><strong>Отвечают не тогда, когда спрашивают.</strong> Обращение приходит в 21:40, менеджер увидит его в девять утра. К этому времени человек уже выбрал тех, кто ответил сразу.</li>
          <li><strong>Вопросы типовые, а отвечают вручную.</strong> «Сколько стоит», «какие сроки», «есть ли в наличии», «как оформить» — на это уходит половина рабочего дня менеджера, хотя ответы уже есть в прайсе и на сайте.</li>
          <li><strong>Форма вместо разговора.</strong> Посетитель пишет вопрос в свободной форме, а получает «оставьте телефон, мы перезвоним». Часть людей не оставляет.</li>
          <li><strong>Ночные и выходные обращения.</strong> По ним часто вообще нет статистики: посетитель не стал ждать и не оставил контактов, поэтому в CRM этой потери нет.</li>
          <li><strong>Диалог никуда не попадает.</strong> Переписка остаётся в виджете или в почте: ни контакта в CRM, ни понимания, чем человек интересовался.</li>
        </ol>

        <figure class="fig bl-fig">
          <figcaption><span>Рис. 2</span><span>Из 20 000 визитов до сделок доходит не всё</span></figcaption>
          <svg viewBox="0 0 720 276" class="fig-svg" role="img" aria-label="Из 20 000 визитов 800 обращений, из них 320 остаются без ответа, ассистент возвращает 112, это 13 сделок в месяц">
            <g class="f-mono" font-size="11">
              <rect x="210" y="8" width="300" height="34" rx="8" fill="rgba(16,16,20,0.05)" stroke="rgba(16,16,20,0.24)" />
              <text x="360" y="30" text-anchor="middle">20 000 визитов в месяц</text>

              <path d="M360 42v10" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <path d="M356 48l4 4 4-4" fill="none" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <text x="372" y="56" class="f-mono">4 % пишут в чат или форму</text>

              <rect x="210" y="64" width="300" height="34" rx="8" fill="rgba(16,16,20,0.05)" stroke="rgba(16,16,20,0.24)" />
              <text x="360" y="86" text-anchor="middle">800 обращений</text>

              <path d="M360 98v10" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <path d="M356 104l4 4 4-4" fill="none" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <text x="372" y="112" class="f-mono">40 % остаются без ответа</text>

              <rect x="210" y="120" width="300" height="34" rx="8" fill="rgba(194,65,12,0.14)" stroke="rgba(194,65,12,0.5)" />
              <text x="360" y="142" text-anchor="middle">320 · ночь, выходные, занятый оператор</text>

              <path d="M360 154v10" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <path d="M356 160l4 4 4-4" fill="none" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <text x="372" y="168" class="f-mono">35 % возвращает ассистент</text>

              <rect x="210" y="176" width="300" height="34" rx="8" fill="rgba(0,217,255,0.1)" stroke="#00D9FF" />
              <text x="360" y="198" text-anchor="middle">112 · ответ за минуту, контакт в CRM</text>

              <path d="M360 210v10" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <path d="M356 216l4 4 4-4" fill="none" stroke="rgba(16,16,20,0.4)" stroke-width="1.5" />
              <text x="372" y="224" class="f-mono">12 % из диалога доходят до сделки</text>

              <rect x="210" y="232" width="300" height="34" rx="8" fill="rgba(14,159,110,0.12)" stroke="#0E9F6E" />
              <text x="360" y="254" text-anchor="middle">13,4 сделки в месяц</text>
            </g>
          </svg>
        </figure>
        <p>Тринадцать сделок при чеке 40 000 ₽ и марже 25 % — это 134 400 ₽ прибыли в месяц с трафика, который вы уже оплатили. Цифры примера: подставьте свои в расчёте ниже.</p>

        <h2 id="sec-2">Что умеет ассистент</h2>
        <p>Пять задач. На пилоте берём одну-две — те, где потери виднее всего.</p>
        <ul>
          <li><strong>Ответы на типовые вопросы.</strong> Цены, сроки, наличие, доставка, гарантия, как оформить — по вашей базе знаний, а не «из головы» модели. Если ответа в базе нет, ассистент этого не выдумывает.</li>
          <li><strong>Квалификация.</strong> Задаёт два-три уточняющих вопроса и собирает карточку: что нужно, какой объём, в какой город, когда. Менеджер получает не «кто-то спрашивал цену», а готовую заявку.</li>
          <li><strong>Запись и передача.</strong> Свободные слоты, запись на звонок, передача диалога менеджеру — с контекстом переписки, чтобы клиент не пересказывал заново.</li>
          <li><strong>Работа в нерабочее время.</strong> Вечер, ночь, выходные, праздники: обращение не лежит до утра, а получает ответ и попадает в CRM.</li>
          <li><strong>Разбор диалогов.</strong> Что спрашивали, где ассистент передал менеджеру, где ответил неточно. Это не «прослушка», а список мест, где сайт теряет деньги.</li>
        </ul>

        <h2 id="sec-3">Считаем эффект: обращения в деньги</h2>
        <p>Считаем на примере сайта с 20 000 визитов в месяц: 4 % пишут в чат — это 800 обращений, 40 % из них остаются без ответа, чек 40 000 ₽, маржа 25 %. Из диалога в сделку — 12 %. Подставьте свои цифры: все ползунки считают заново.</p>

        <Calc fig={3} title="Возвращённые обращения в деньгах" inputs={mgIn} cols={2}
          main={{ expr: EFFECT, label: 'Эффект до вычета расходов', unit: '₽/мес', dig: 0 }}
          rows={mgRows} verdict={mgVerdict}
          note="Цепочка: визиты × доля пишущих × доля без ответа × какая часть возвращается в диалог × конверсия в сделку × чек × маржа. Из прибыли вычитаем поддержку, разовый пилот с внедрением делим на остаток — это окупаемость. Доля возврата 35 % и конверсия 12 % — осторожные допущения, а не обещания: на пилоте их и проверяем. Время менеджера в расчёт не берём — экономия на часах идёт сверху, чтобы не завышать эффект. Окупаемость больше 120 месяцев — показываем «—»." />

        <p>Обратите внимание на пропорцию: ассистент не «ускоряет менеджеров», он возвращает обращения, которые раньше терялись. В примере это 13 сделок в месяц с того же трафика и того же штата.</p>

        <h2 id="sec-4">Замер до и после на одном трафике</h2>
        <p>Тот же сайт, замер до и после. Цифры примера: на пилоте фиксируем ваши.</p>

        <Aba fig={4} title="Один сценарий, четыре метрики" rows={abaRows} caption="замер на одном и том же трафике"
          verdict="Главная строка — доля обращений без ответа: 40 % → 26 %. Всё остальное следует из неё."
          note="Время ответа и доля обработанных обращений измеряются автоматически. Сделки считаем за полный месяц до и полный месяц после: на более коротком отрезке разница тонет в обычном разбросе трафика." />

        <h2 id="sec-5">Как проходит внедрение</h2>

        <Timeline fig={5} title="От аудита до сопровождения" stages={mgTl} />

        <h2 id="sec-6">Стоимость и сроки</h2>
        <ul>
          <li><strong>Аудит — 0 ₽.</strong> Разбираем, что спрашивают на сайте, и считаем экономику. Если ассистент не окупится, говорим об этом на аудите, а не после оплаты.</li>
          <li><strong>Пилот 2–4 недели — от 50 000 до 150 000 ₽.</strong> Один сценарий. Зависит от объёма базы знаний и числа интеграций.</li>
          <li><strong>Внедрение — от 200 000 ₽.</strong> Объём и срок называем после пилота, когда известны реальные цифры.</li>
          <li><strong>Дальше — сопровождение:</strong> обновление базы знаний, разбор диалогов, отчёт раз в месяц.</li>
        </ul>
        <p>Посчитать окупаемость можно самому — ползунки выше работают без заявки. Разбор конкретных вилок цен — в статье <a href="/blog/skolko-stoit-vnedrenie-ii.html">«Сколько стоит внедрение ИИ»</a>.</p>

        <h2 id="sec-7">Что нужно от вас для старта</h2>
        <p>Семь пунктов. Отметьте, что уже есть: шкала покажет, можно ли начинать.</p>

        <Checklist fig={6} title="Готовность сайта к пилоту" items={checkItems}
          note="Отмечайте честно: если трафика мало или некому править базу знаний, пилот это покажет, но деньги будут потрачены зря." />

        <h2 id="sec-8">Смотрите также</h2>
        <div class="bl-more" aria-label="Полезные материалы">
