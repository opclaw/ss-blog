---
// ИИ-ассистент для сайта: коммерческий раздел-посадочная (в корне, схема Service).
// Структура раздела, а не статьи: оффер с ценой → проблема → цена потерянных обращений →
// что умеет ассистент → инструмент расчёта → замер до/после → порядок внедрения → цены →
// готовность → разборы по теме → FAQ → контакты.
// От статьи /blog/chto-takoe-ii-agent.html отличается интентом: там «что такое ИИ-агент»,
// здесь — «сколько стоит ассистент, за какой срок и что он возвращает».
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
import { assetV } from '../data/asset-version';
import Funnel from '../components/blog/Funnel.astro';
import Calc from '../components/blog/Calc.astro';
import Aba from '../components/blog/Aba.astro';
import Timeline from '../components/blog/Timeline.astro';
import Checklist from '../components/blog/Checklist.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import HeroPanel from '../components/landing/HeroPanel.astro';
import LdSection from '../components/landing/LdSection.astro';
import LdCards from '../components/landing/LdCards.astro';
import LdPrices from '../components/landing/LdPrices.astro';
import LdFaq from '../components/landing/LdFaq.astro';
import LdLinks from '../components/landing/LdLinks.astro';

// Все значения по умолчанию кратны шагу ползунка: иначе браузер подменит значение
// и расчёт на странице разойдётся с текстом (ловили трижды на статьях).
const mgIn = [
  { id: 'v', label: 'Визитов в месяц', min: 1000, max: 100000, step: 1000, value: 20000 },
  { id: 'ask', label: 'Пишут в чат или форму', min: 1, max: 20, step: 1, value: 4, unit: ' %' },
  { id: 'lost', label: 'Остаются без ответа', min: 10, max: 90, step: 5, value: 40, unit: ' %' },
  { id: 'back', label: 'Ассистент возвращает в диалог', min: 5, max: 60, step: 5, value: 35, unit: ' %' },
  { id: 'lead', label: 'Из диалога в сделку', min: 2, max: 40, step: 1, value: 12, unit: ' %' },
  { id: 'c', label: 'Средний чек', min: 5000, max: 500000, step: 5000, value: 40000, unit: ' ₽' },
  { id: 'm', label: 'Маржа', min: 5, max: 60, step: 5, value: 25, unit: ' %' },
  { id: 'sup', label: 'Поддержка в месяц', min: 5000, max: 100000, step: 5000, value: 15000, unit: ' ₽' },
  { id: 'setup', label: 'Пилот и внедрение разово', min: 50000, max: 500000, step: 10000, value: 250000, unit: ' ₽' },
];
const EFFECT = 'v*ask/100*lost/100*back/100*lead/100*c*m/100';
const mgRows = [
  { expr: 'v*ask/100', label: 'Обращений в месяц', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100', label: 'Из них без ответа', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100*back/100', label: 'Возвращает ассистент', unit: 'шт', dig: 0 },
  { expr: 'v*ask/100*lost/100*back/100*lead/100', label: 'Сделок с них', unit: 'шт', dig: 1 },
  { expr: 'v*ask/100*lost/100*back/100*lead/100*c', label: 'Выручка с них', unit: '₽/мес', dig: 0 },
  { expr: EFFECT, label: 'Прибыль с них', unit: '₽/мес', dig: 0 },
  { expr: `${EFFECT} - sup`, label: 'Чистый эффект', unit: '₽/мес', dig: 0 },
  { expr: `setup/Math.max(1, ${EFFECT} - sup)`, label: 'Окупаемость', unit: 'мес', dig: 1, cap: 120 },
];
// Пороги те же, что во всех калькуляторах блога: 4 / 9 месяцев.
const mgVerdict = {
  expr: `setup/Math.max(1, ${EFFECT} - sup)`,
  levels: [
    { max: 4, text: 'До 4 месяцев — делать: трафик сайта окупает ассистента быстро.', tone: 'go' },
    { max: 9, text: '4–9 месяцев — обсуждаемо: считайте на большем трафике или берите базовый пилот.', tone: 'check' },
    { max: 999, text: 'Больше 9 месяцев — не делаем: при таком трафике расходы не отобьются.', tone: 'stop' },
  ],
};

const mgTl = [
  { label: 'Аудит', who: 'человек', text: 'Разбираем, что спрашивают на сайте, и считаем долю обращений без ответа. Аудит бесплатный и ни к чему не обязывает: если ассистент не окупится, мы скажем об этом сразу.' },
  { label: 'Пилот', who: 'ИИ+человек', text: 'Берём один сценарий — обычно цены, сроки и запись — и запускаем на 2–4 недели. До старта фиксируем метрики, чтобы потом было с чем сравнивать.' },
  { label: 'Замер', who: 'человек', text: 'Сравниваем долю обращений без ответа, время первого ответа и сделки с сайта до и после. Считаем ошибки: сколько диалогов ассистент закрыл сам, а сколько передал менеджеру.' },
  { label: 'Масштабирование', who: 'ИИ+человек', text: 'Расширяем сценарии, подключаем мессенджеры и CRM. Дальше — сопровождение: обновление базы знаний, разбор диалогов, отчёт раз в месяц.' },
];

// Замер до/после — те же 800 обращений и 40 % без ответа, что в расчёте выше.
const abaRows = [
  { label: 'Время первого ответа', before: 45, after: 1, unit: 'мин', note: 'ночью и в выходные обращение вообще ждало утра' },
  { label: 'Доля обращений без ответа', before: 40, after: 26, unit: '%', note: '320 из 800 было, стало 208: остальное забирает ассистент' },
  { label: 'Сделок с сайта в месяц', before: 57.1, after: 70.5, unit: 'шт', note: 'было 57,1 — столько же показывает воронка выше; +13,4 возвращённых' },
  { label: 'Выручка с сайта', before: 2284000, after: 2820000, unit: '₽', note: '70,5 × 40 000 ₽; по марже 25 % это +134 400 ₽ прибыли' },
];

const problems = [
  { n: '01', t: 'Отвечают не тогда, когда спрашивают', d: 'Обращение приходит в 21:40, менеджер увидит его в девять утра. К этому времени человек уже выбрал тех, кто ответил сразу.' },
  { n: '02', t: 'Вопросы типовые, а отвечают вручную', d: '«Сколько стоит», «какие сроки», «есть ли в наличии», «как оформить» — это половина рабочего дня менеджера, хотя ответы уже есть в прайсе и на сайте.' },
  { n: '03', t: 'Форма вместо разговора', d: 'Посетитель пишет вопрос в свободной форме, а получает «оставьте телефон, мы перезвоним». Часть людей не оставляет — и уходит.' },
  { n: '04', t: 'Ночные и выходные обращения', d: 'По ним часто вообще нет статистики: посетитель не стал ждать и не оставил контактов, поэтому в CRM этой потери не видно.' },
  { n: '05', t: 'Диалог никуда не попадает', d: 'Переписка остаётся в виджете или в почте: ни контакта в CRM, ни понимания, чем человек интересовался.' },
];

const abilities = [
  { t: 'Ответы на типовые вопросы', d: 'Цены, сроки, наличие, доставка, гарантия, как оформить — по вашей базе знаний, а не «из головы» модели. Если ответа в базе нет, ассистент этого не выдумывает.', note: 'пополняет базу знаний и снимает спорные ответы', noteLabel: 'Человек' },
  { t: 'Квалификация', d: 'Задаёт два-три уточняющих вопроса и собирает карточку: что нужно, какой объём, в какой город, когда. Менеджер получает не «кто-то спрашивал цену», а готовую заявку.', note: 'ведёт переговоры и закрывает сделку', noteLabel: 'Человек' },
  { t: 'Запись и передача диалога', d: 'Свободные слоты, запись на звонок, передача менеджеру — с контекстом переписки, чтобы клиент не пересказывал заново.', note: 'подтверждает нестандартные условия и скидки', noteLabel: 'Человек' },
  { t: 'Работа в нерабочее время', d: 'Вечер, ночь, выходные, праздники: обращение не лежит до утра, а получает ответ и попадает в CRM.', note: 'утром менеджер видит готовые диалоги, а не пропущенные', noteLabel: 'Человек' },
  { t: 'Разбор диалогов', d: 'Что спрашивали, где ассистент передал менеджеру, где ответил неточно. Это не «прослушка», а список мест, где сайт теряет деньги.', note: 'решает, что менять в базе знаний и сценариях', noteLabel: 'Человек' },
];

const plans = [
  {
    name: 'Аудит',
    price: '0 ₽',
    term: '1–2 дня',
    items: [
      'Смотрим, что спрашивают на сайте, и считаем обращения без ответа',
      'Называем метрики, по которым будем мерить эффект',
      'Если не окупится — говорим сразу, до оплаты',
    ],
  },
  {
    name: 'Пилот',
    price: '50 000–150 000 ₽',
    term: '2–4 недели',
    featured: true,
    items: [
      'Один сценарий: цены, сроки, запись или наличие',
      'Отвечает по вашей базе знаний, передаёт диалог менеджеру',
      'Замер до и после: доля без ответа, время ответа, сделки',
      'Первые 2–3 недели человек выборочно проверяет диалоги',
    ],
  },
  {
    name: 'Внедрение',
    price: 'от 200 000 ₽',
    term: 'объём и срок — после пилота',
    items: [
      'Расширяем сценарии и подключаем мессенджеры',
      'Интеграции с CRM и учётными системами',
      'Права доступа, контур данных, регламенты',
    ],
  },
  {
    name: 'Сопровождение',
    price: 'по объёму',
    term: 'ежемесячно',
    items: [
      'Обновление базы знаний',
      'Разбор диалогов и контроль качества',
      'Отчёт раз в месяц',
    ],
  },
];

const checkItems = [
  'На сайте понятен объём: хотя бы 1 000 визитов и 50 обращений в месяц.',
  'Типовые вопросы собраны: цены, сроки, доставка, гарантия, как заказать.',
  'Есть база знаний для ответов: прайс, каталог, описание услуг, готовый FAQ.',
  'Понятно, куда уходит обращение: почта, CRM, Telegram ответственного менеджера.',
  'Назначен человек, который первые 2–3 недели читает диалоги и правит базу знаний.',
  'Есть кому смотреть цифры: доля без ответа, время ответа, сделки с сайта.',
  'Руководитель готов начать с одного сценария, а не автоматизировать все вопросы сразу.',
];

const links = [
  { href: '/blog/chto-takoe-ii-agent.html', meta: 'разбор', title: 'Что такое ИИ-агент простыми словами' },
  { href: '/blog/skolko-stoit-vnedrenie-ii.html', meta: 'стоимость', title: 'Сколько стоит внедрение ИИ: из чего складывается цена' },
  { href: '/avtomatizaciya-prodazh.html', meta: 'соседняя услуга', title: 'Автоматизация продаж: первый ответ и дожим' },
  { href: '/ai.html', meta: 'направление', title: 'Внедрение ИИ в процессы: как мы работаем' },
];

const faq = [
  {
    q: 'Сколько стоит ИИ-ассистент для сайта?',
    a: 'Аудит бесплатный. Пилот на одном сценарии — от 50 000 до 150 000 ₽ в зависимости от объёма базы знаний и числа интеграций. Полноценное внедрение — от 200 000 ₽, поддержка обсуждается отдельно. Точная сумма называется после аудита.',
  },
  {
    q: 'Чем он отличается от обычного чат-бота с кнопками?',
    a: 'Обычный бот ведёт по сценарию «нажмите 1, нажмите 2» и теряется на любом нестандартном вопросе. Ассистент отвечает на свободные вопросы по вашей базе знаний: понимает «а сколько будет с доставкой в Казань?», находит ответ в прайсе и отвечает по нему. Сценарии нужны там, где нужен порядок действий — запись, оформление, передача менеджеру.',
  },
  {
    q: 'Не будет ли он выдумывать ответы клиентам?',
    a: 'Ассистент отвечает по вашей базе знаний и не придумывает того, чего в ней нет: если уверенности недостаточно, он уточняет вопрос или передаёт диалог менеджеру. Первые 2–3 недели человек выборочно проверяет диалоги — это условие запуска, а не опция.',
  },
  {
    q: 'Как быстро ассистент заработает на сайте?',
    a: 'Базовый сценарий — цены, сроки, запись — поднимаем за 2–4 недели. Срок зависит от объёма базы знаний и числа интеграций: если ответы собраны, быстрее; если их предстоит писать с нуля, дольше.',
  },
  {
    q: 'Нужен ли свой сервер и что с персональными данными?',
    a: 'Работаем в закрытом контуре или на российских моделях — как удобнее вам. Где живут данные и кто имеет к ним доступ, прописываем в договоре до старта, а не после.',
  },
  {
    q: 'Как поймём, что сработало?',
    a: 'Метрики фиксируем до старта: доля обращений без ответа, время первого ответа, сделки с сайта. Сравниваем полный месяц до и полный месяц после — на коротком отрезке разница тонет в обычном разбросе трафика.',
  },
];

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://smartsolutions.today/' },
      { '@type': 'ListItem', position: 2, name: 'AI-направление', item: 'https://smartsolutions.today/ai.html' },
      { '@type': 'ListItem', position: 3, name: 'ИИ-ассистент для сайта', item: 'https://smartsolutions.today/ii-assistent-dlya-sajta.html' },
    ],
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'ИИ-ассистент для сайта',
    serviceType: 'ИИ-ассистент, отвечающий посетителям сайта по базе знаний',
    provider: { '@type': 'Organization', name: 'Smart Solutions', url: 'https://smartsolutions.today/' },
    areaServed: 'RU',
    description:
      'ИИ-ассистент для сайта: отвечает на вопросы посетителей по базе знаний в любое время суток, собирает заявку и передаёт диалог менеджеру. Пилот 2–4 недели, замер эффекта до и после.',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }),
];
---

<Base
  jsonLd={jsonLd}
  title="ИИ-ассистент для сайта:  цена, сроки — Smart Solutions"
  description="ИИ-ассистент для сайта отвечает на вопросы посетителей по вашей базе знаний: цены, сроки, запись. Считаем эффект в рублях до договора. Пилот 2–4 недели — от 50 000 ₽."
  path="/ii-assistent-dlya-sajta.html"
  ogDescription="Посетитель написал в 21:40, менеджер ответит утром — или ответит ассистент через минуту. Сначала считаем, потом запускаем."
  active="ai"
  mainWrap={false}
  skipTo="#main-content"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={`/blog-assets/article.css?v=${assetV('/blog-assets/article.css')}`} />
    <link rel="stylesheet" href={`/blog-assets/kit.css?v=${assetV('/blog-assets/kit.css')}`} />
  </Fragment>

  {/* bl-dark — тёмные токены для интерактива и схем: раздел живёт в тёмной теме сайта */}
  <main class="bl-dark ld-page" id="main-content">
    <LandingHero
      label="Услуга · AI-направление"
      title="ИИ-ассистент для сайта:&nbsp;<br><span class='text-accent'>цена, сроки и расчёт эффекта</span>"
      lead="Отвечает посетителям по вашей базе знаний в любое время суток, собирает заявку и передаёт менеджеру готовый диалог. Считаем эффект в рублях до договора, пилот — 2–4 недели с замером до и после."
      prices={['Аудит — 0 ₽', 'Пилот 2–4 недели — 50 000–150 000 ₽', 'Внедрение — от 200 000 ₽']}
      actions={[
        { href: '#contacts', label: 'Обсудить задачу' },
        { href: '#raschet', label: 'Посчитать окупаемость', kind: 'outline' },
      ]}
    >
      <HeroPanel slot="aside"
        head="посетитель · сайт"
        time="ответ ~1 мин"
        steps={[
          { t: 'Вопрос на сайте: цена, срок, наличие', d: 'Вечер и выходные — оператора нет' },
          { t: 'Ответ по вашей базе знаний и прайсу', d: 'Со ссылкой на источник, без выдумок' },
          { t: 'Диалог и контакт уходят менеджеру', d: 'Утром человек продолжает с готовым контекстом' },
        ]}
        foot="Вопрос не по базе — ассистент передаёт человеку, а не догадывается"
      />
    </LandingHero>

    <LdSection id="problema" label="Что теряется" title="Где сайт теряет обращения"
      sub="Пять причин, которые мы проверяем на аудите. Обычно работают две-три сразу."
    >
      <LdCards items={problems} />
    </LdSection>

    <LdSection id="cena-otveta" alt label="Цена потерянных обращений" title="Из 20 000 визитов до сделок доходит не всё"
      sub="Пример сайта: 20 000 визитов в месяц, 4 % пишут в чат — это 800 обращений, 40 % из них остаются без ответа, чек 40 000 ₽, маржа 25 %."
    >
      <div class="ld-stats">
        <div class="ld-stat"><b>320</b><span>обращений в месяц остаются без ответа — ночь, выходные, занятый оператор</span></div>
        <div class="ld-stat"><b>112</b><span>из них возвращает в диалог ассистент: осторожная доля 35 %</span></div>
        <div class="ld-stat"><b>134 400 <em>₽/мес</em></b><span>прибыль с возвращённых сделок при марже 25 %</span></div>
      </div>

      <figure class="fig bl-fig">
        <figcaption><span>Как считаем</span><span>Из 20 000 визитов до сделок доходит не всё</span></figcaption>
        <svg viewBox="0 0 720 276" class="fig-svg" role="img" aria-label="Из 20 000 визитов 800 обращений, из них 320 остаются без ответа, ассистент возвращает 112, это 13 сделок в месяц">
          <g class="f-mono" font-size="11">
            <rect x="210" y="8" width="300" height="34" rx="8" class="fg-plate" />
            <text x="360" y="30" text-anchor="middle">20 000 визитов в месяц</text>

            <path d="M360 42v10" class="fg-plate-line" stroke-width="1.5" />
            <path d="M356 48l4 4 4-4" fill="none" class="fg-plate-line" stroke-width="1.5" />
            <text x="372" y="56" class="f-mono">4 % пишут в чат или форму</text>

            <rect x="210" y="64" width="300" height="34" rx="8" class="fg-plate" />
            <text x="360" y="86" text-anchor="middle">800 обращений</text>

            <path d="M360 98v10" class="fg-plate-line" stroke-width="1.5" />
            <path d="M356 104l4 4 4-4" fill="none" class="fg-plate-line" stroke-width="1.5" />
            <text x="372" y="112" class="f-mono">40 % остаются без ответа</text>

            <rect x="210" y="120" width="300" height="34" rx="8" class="fg-warn-plate" />
            <text x="360" y="142" text-anchor="middle">320 · ночь, выходные, занятый оператор</text>

            <path d="M360 154v10" class="fg-plate-line" stroke-width="1.5" />
            <path d="M356 160l4 4 4-4" fill="none" class="fg-plate-line" stroke-width="1.5" />
            <text x="372" y="168" class="f-mono">35 % возвращает ассистент</text>

            <rect x="210" y="176" width="300" height="34" rx="8" class="fg-acc-plate" />
            <text x="360" y="198" text-anchor="middle">112 · ответ за минуту, контакт в CRM</text>

            <path d="M360 210v10" class="fg-plate-line" stroke-width="1.5" />
            <path d="M356 216l4 4 4-4" fill="none" class="fg-plate-line" stroke-width="1.5" />
            <text x="372" y="224" class="f-mono">12 % из диалога доходят до сделки</text>

            <rect x="210" y="232" width="300" height="34" rx="8" class="fg-green-plate" />
            <text x="360" y="254" text-anchor="middle">13,4 сделки в месяц</text>
          </g>
        </svg>
      </figure>

      <p class="ld-after">
        Тринадцать сделок при чеке 40 000 ₽ и марже 25 % — это <b>134 400 ₽ прибыли в месяц</b>
        с трафика, который вы уже оплатили. Цифры примера: свои подставьте в расчёте ниже.
      </p>
    </LdSection>

    <LdSection id="chto-umeet" label="Что делаем" title="Что умеет ассистент"
      sub="Пять задач. На пилоте берём одну-две — те, где потери виднее всего. Дальше у каждого пункта указано, что остаётся за человеком."
    >
      <LdCards items={abilities} />
    </LdSection>

    <LdSection id="raschet" alt label="Инструмент" title="Посчитайте окупаемость на своих цифрах"
      sub="Ползунки работают без заявки: подставьте свои числа — модель пересчитает. Никакой внешней статистики, только следствия введённых цифр."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Funnel title="Сколько обращений доживает до диалога" n={800} t={45} half={60} k={12} c={40000}
          note="Модель считает по вашим же числам: сколько обращений в месяц, через сколько минут отвечаете сейчас, за сколько минут интерес остывает вдвое и какая конверсия из диалога в сделку. На цифрах примера предел — +38 сделок, но отвечать за минуту на всё не получится: в расчёте ниже берём осторожную долю, 35 % из обращений без ответа — это 13 сделок. Никакой внешней статистики: только следствия введённых цифр." />

        <Calc title="Возвращённые обращения в деньгах" inputs={mgIn} cols={2}
          main={{ expr: EFFECT, label: 'Эффект до вычета расходов', unit: '₽/мес', dig: 0 }}
          rows={mgRows} verdict={mgVerdict}
          note="Цепочка: визиты × доля пишущих × доля без ответа × какая часть возвращается в диалог × конверсия в сделку × чек × маржа. Из прибыли вычитаем поддержку, разовый пилот с внедрением делим на остаток — это окупаемость. Доля возврата 35 % и конверсия 12 % — осторожные допущения, а не обещания: на пилоте их и проверяем. Время менеджера в расчёт не берём — экономия на часах идёт сверху, чтобы не завышать эффект. Окупаемость больше 120 месяцев — показываем «—»." />
      </div>

      <p class="ld-after">
        В расчёте намеренно нет экономии на часах менеджера: даже без неё сайт с 20 000 визитов
        окупает ассистента за <b>2–3 месяца</b>. Всё, что выше, — уже сверху.
      </p>
    </LdSection>

    <LdSection id="zamer" label="Замер до и после" title="Как выглядит результат пилота"
      sub="Те же каналы, тот же трафик и та же реклама. Цифры примера — на пилоте фиксируем ваши."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Aba title="Один сценарий, четыре метрики" rows={abaRows} caption="замер на одном и том же трафике"
          verdict="Главная строка — сделки с сайта: +13,4 в месяц при том же трафике и рекламном бюджете."
          note="Долю обращений без ответа и время ответа измеряем автоматически. Сделки считаем за полный месяц до и полный месяц после: на более коротком отрезке разница тонет в обычном разбросе трафика." />
      </div>
    </LdSection>

    <LdSection id="process" alt label="Порядок работ" title="Как проходит внедрение"
      sub="Четыре шага. Пилот — 2–4 недели, метрики фиксируем до старта, деньги — после замера."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Timeline title="От аудита до сопровождения" stages={mgTl} />
      </div>
    </LdSection>

    <LdSection id="ceny" label="Цены и сроки" title="Сколько это стоит и когда платить"
      sub="Точную сумму называем после аудита, когда понятен объём базы знаний и интеграций. Годовой договор до замера эффекта не предлагаем."
    >
      <LdPrices plans={plans} ctaLabel="Обсудить" />
      <p class="ld-after">
        Считать окупаемость можно самому — ползунки в разделе «Посчитайте окупаемость» работают без заявки.
        Разбор того, из чего складывается цена, — в статье <a href="/blog/skolko-stoit-vnedrenie-ii.html">«Сколько стоит внедрение ИИ»</a>.
      </p>
    </LdSection>

    <LdSection id="gotovnost" alt label="Готовность" title="Что нужно от вас для старта"
      sub="Семь пунктов. Отметьте, что уже есть: шкала покажет, можно ли начинать."
      bodyClass="ld-tools"
    >
      <div class="bl-dark">
        <Checklist title="Готовность сайта к пилоту" items={checkItems}
          note="Отмечайте честно: если трафика мало или некому править базу знаний, пилот это покажет, но деньги будут потрачены зря." />
      </div>
    </LdSection>

    <LdSection id="chitat" label="По теме" title="Разборы и расчёты"
      sub="Блог отвечает «что такое» и «как», раздел — «сколько, за какой срок и что это даёт»."
    >
      <LdLinks items={links} />
    </LdSection>

    <LdSection id="faq" alt label="Вопросы" title="Частые вопросы">
      <LdFaq items={faq} />
    </LdSection>

    <section id="contacts" class="section section-cta">
      <div class="container">
        <div class="cta-content">
          <h2 class="cta-title">Покажем ассистента на ваших вопросах</h2>
          <p class="text-secondary cta-subtitle">Возьмём один сценарий с вашего сайта и соберём ответы. Аудит бесплатный.</p>
          <ContactCards />
        </div>
      </div>
    </section>

    <Fragment slot="tail">
      <script is:inline src={`/blog-assets/kit.js?v=${assetV('/blog-assets/kit.js')}`}></script>
    </Fragment>
  </main>
</Base>
