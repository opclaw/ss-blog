      <text x="540" y="90" fill="#8C8C96" font-family="Manrope" font-size="13" text-anchor="middle">Окупаемость</text>
      <text x="540" y="130" fill="#0A7EA4" font-family="Manrope" font-size="34" font-weight="800" text-anchor="middle">11,7 мес</text>
      <text x="540" y="165" fill="#5E5E68" font-family="Manrope" font-size="13" text-anchor="middle">150 000 ÷ 12 800</text>
      <text x="540" y="195" fill="#C2410C" font-family="Manrope" font-size="12" text-anchor="middle">Долго — ищем сильнее</text>
    </svg>
