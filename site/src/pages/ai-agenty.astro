---
// Посадочная под коммерческий спрос кластера «ИИ-агенты» (Wordstat: «ии агент» 72 294 показов/мес,
// «ai агент» 11 385, «создание ии агентов» 3 660, «разработка ии агентов» 1 522, «ии агент для 1с» 526).
// Обещания и цены — только те, что уже согласованы владельцем на /ai.html: бесплатный аудит,
// пилот 2–4 недели, «точную цифру называем после аудита». Ничего нового про сроки и деньги не выдумываем.
// FAQ — один источник: из массива faq строятся и видимый блок, и разметка FAQPage.
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';

const faq = [
  {
    q: 'Чем ИИ-агент отличается от чат-бота?',
    a: 'Чат-бот идёт по заранее написанному сценарию: нажали кнопку — получили заготовку. Агент понимает текст, сам решает, какой шаг сделать следующим, и вызывает инструменты: ищет в вашей базе знаний, смотрит заявку в CRM, готовит черновик документа. Разница видна на нестандартном запросе: бот отвечает «я вас не понял», агент — разбирает задачу по частям.',
  },
  {
    q: 'Сколько стоит разработка ИИ-агента?',
    a: 'Зависит от процесса: какие данные нужны, сколько интеграций, сколько сценариев и какова цена ошибки. Аудит бесплатный — после него называем точную цифру и прогноз окупаемости. Если окупаемости нет, так и скажем: внедрять не стоит.',
  },
  {
    q: 'Можно ли сделать агента для 1С?',
    a: 'Да, если у вашей конфигурации есть API, веб-сервисы или доступ к базе на чтение — через них агент получает данные и создаёт документы. Конкретный способ фиксируем на аудите: у 1С вариантов интеграции несколько, и не все одинаково безопасны. Обещать «подключим к любой 1С» заранее не будем.',
  },
  {
    q: 'Работает ли агент на российских моделях: GigaChat, YandexGPT?',
    a: 'Да. Мы не привязываемся к одному поставщику: если ваши правила безопасности требуют, чтобы данные не покидали контур, собираем решение на российских или локальных моделях. Выбор модели — вопрос требований и стоимости, а не идеологии, и решается на аудите.',
  },
  {
    q: 'Что будет, если агент ошибётся?',
    a: 'На старте агент не отправляет ничего клиенту и не проводит документы сам: он готовит черновик, человек проверяет и подтверждает. Коммерчески значимые шаги остаются под контролем до тех пор, пока на статистике не станет видно, что качество стабильно. Ошибки разбираем по логам: видно, какой шаг и на каких данных дал сбой.',
  },
  {
    q: 'Можно ли поставить агента на сайт, чтобы он отвечал клиентам?',
    a: 'Да, это частый первый проект: агент отвечает на вопросы по вашим материалам — услугам, ценам, срокам, доставке — и передаёт человеку то, что не должен решать сам. Обязательное условие — база знаний: если её нет, сначала собираем, иначе агент будет уверенно придумывать ответы.',
  },
  {
    q: 'Сколько времени занимает внедрение?',
    a: 'Пилот на одном процессе — 2–4 недели: замер, сбор данных, работа в бою на реальных задачах, повторный замер. Дальше решение по цифрам: масштабировать или остановиться. Мы не берём «внедрение ИИ во всю компанию» одним проектом — так не работает.',
  },
  {
    q: 'У нас нет базы знаний. Агент не заработает?',
    a: 'Заработает, но не сразу. Сначала собираем минимальную базу: регламенты, ответы на частые вопросы, шаблоны, историю переписки. Это часть пилота, а не отдельный проект на полгода. Если данных объективно нет — честно скажем, что сначала нужно навести порядок в процессе.',
  },
];

const jsonLd = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Разработка и внедрение ИИ-агентов для бизнеса',
    serviceType: 'Внедрение ИИ-агентов в бизнес-процессы',
    url: 'https://smartsolutions.today/ai-agenty.html',
    description:
      'ИИ-агенты под конкретный процесс: обработка заявок, ассистент по базе знаний, документы, поддержка на сайте. Интеграции с CRM, 1С и мессенджерами, пилот 2–4 недели, замер эффекта до старта.',
    areaServed: { '@type': 'Country', name: 'Россия' },
    provider: {
      '@type': 'Organization',
      name: 'Smart Solutions',
      url: 'https://smartsolutions.today/',
    },
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://smartsolutions.today/' },
      { '@type': 'ListItem', position: 2, name: 'AI-направление', item: 'https://smartsolutions.today/ai.html' },
      { '@type': 'ListItem', position: 3, name: 'ИИ-агенты для бизнеса', item: 'https://smartsolutions.today/ai-agenty.html' },
    ],
  }),
];

const scenarios = [
  {
    n: '01',
    t: 'Обработка входящих заявок',
    d: 'Агент читает обращение из формы, почты или мессенджера, вытаскивает данные, задаёт человеку уточняющие вопросы и готовит черновик ответа.',
    human: 'менеджер проверяет и отправляет',
  },
  {
    n: '02',
    t: 'Ассистент по базе знаний',
    d: 'Отвечает сотрудникам и клиентам по вашим регламентам, ценам и инструкциям — со ссылкой на источник, а не «из интернета».',
    human: 'владелец базы следит за актуальностью',
  },
  {
    n: '03',
    t: 'Документы и коммерческие предложения',
    d: 'Первые версии КП, договоров, актов и отчётов по вашим шаблонам и с вашими данными — за минуты вместо часа.',
    human: 'юрист или руководитель утверждает',
  },
  {
    n: '04',
    t: 'Работа с CRM',
    d: 'Заполняет карточки, обновляет статусы, ставит задачи и напоминания, готовит сводку по сделкам к планёрке.',
    human: 'руководитель принимает решения по сводке',
  },
  {
    n: '05',
    t: 'Агент на сайте',
    d: 'Отвечает посетителю по вашим материалам и передаёт человеку всё, что требует решения: скидку, сроки, нестандарт.',
    human: 'менеджер подхватывает диалог',
  },
  {
    n: '06',
    t: 'Внутренняя рутина команды',
    d: 'Собирает выжимки из переписок и документов, готовит ответы на типовые вопросы, ведёт чек-листы регламентов.',
    human: 'сотрудник проверяет перед использованием',
  },
];

const layers = [
  { t: 'Данные', d: 'База знаний, регламенты, шаблоны, история обращений. Слабое место большинства проектов — не модель, а данные.' },
  { t: 'Доступы', d: 'Что агент видит, что может менять, что запрещено. Права настраиваются на уровне действий, а не «на всё сразу».' },
  { t: 'Модель', d: 'Российская, локальная или внешняя — по вашим требованиям к данным. Можно менять, не переписывая процесс.' },
  { t: 'Инструменты', d: 'Поиск по базе, CRM, 1С, почта, мессенджеры, генерация документов. Агент не «разговаривает», а выполняет шаги.' },
  { t: 'Контроль', d: 'Человек подтверждает значимые действия. Логи показывают, что агент сделал и на каких данных основал ответ.' },
];
---

<Base
  jsonLd={jsonLd}
  title={'ИИ-агенты для бизнеса: разработка и внедрение'}
  description={'ИИ-агенты под ваш процесс: заявки, документы, база знаний, поддержка на сайте. Интеграции с CRM и 1С, пилот 2–4 недели, эффект считаем до старта.'}
  ogDescription={'ИИ-агент не «отвечает красиво», а выполняет шаги в вашем процессе: ищет в базе знаний, обновляет CRM, готовит документы. Человек подтверждает — эффект замеряем.'}
  path="/ai-agenty.html"
  active="ai"
>
<style is:inline slot="head">
    /* Страница «ИИ-агенты»: локальные стили с префиксом ag-, общие классы — из styles.css. */
    .ag-hero { padding-top: clamp(140px, 18vh, 200px); padding-bottom: clamp(72px, 9vh, 120px); }
    .ag-hero-layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(320px, 5fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
    .ag-title { font-family: 'Manrope', sans-serif; font-size: clamp(2.4rem, 5.2vw, 4.3rem); font-weight: 800; letter-spacing: -0.032em; line-height: 1.05; margin: 22px 0 26px; }
    .ag-lead { max-width: 600px; }
    .ag-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
    .ag-h2 { font-family: 'Manrope', sans-serif; font-size: clamp(1.7rem, 3.4vw, 2.6rem); font-weight: 800; letter-spacing: -0.026em; line-height: 1.12; margin: 0 0 18px; }
    .ag-h2 em { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; }
    .ag-sec-label { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .ag-sec-num { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); border: 1px solid var(--border-hover); border-radius: 6px; padding: 3px 7px; }
    .ag-sub { max-width: 720px; margin-bottom: 34px; }

    /* hero: карточка агента */
    .ag-agent { background: var(--bg-elevated); border: 1px solid var(--border-hover); border-radius: var(--radius); overflow: hidden; }
    .ag-agent-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px dashed var(--border); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .ag-agent-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 10px var(--green-glow); display: inline-block; margin-right: 8px; }
    .ag-agent-body { padding: 18px; display: grid; gap: 12px; }
    .ag-step { display: grid; grid-template-columns: 26px 1fr; gap: 12px; align-items: start; }
    .ag-step-n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent); padding-top: 3px; }
    .ag-step-t { font-size: 0.92rem; color: var(--fg); }
    .ag-step-d { font-size: 0.8rem; color: var(--secondary); margin-top: 3px; }
    .ag-agent-foot { padding: 13px 18px; border-top: 1px dashed var(--border); font-size: 0.78rem; color: var(--muted); }

    /* таблица сравнения */
    .ag-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
    .ag-table { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.92rem; }
    .ag-table th, .ag-table td { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .ag-table thead th { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: var(--bg-elevated); }
    .ag-table tbody tr:last-child td { border-bottom: 0; }
    .ag-table td:first-child { color: var(--secondary); white-space: nowrap; }
    .ag-table .ag-yes { color: var(--green); }
    .ag-table .ag-no { color: var(--muted); }

    /* сценарии */
    .ag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
    .ag-card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; display: flex; flex-direction: column; gap: 10px; transition: border-color var(--transition), transform var(--transition); }
    .ag-card:hover { border-color: var(--border-hover); transform: translateY(-2px); }
    .ag-card-n { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); }
    .ag-card-t { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 1.08rem; letter-spacing: -0.01em; }
    .ag-card-d { font-size: 0.92rem; color: var(--secondary); }
    .ag-card-h { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--border); font-size: 0.78rem; color: var(--muted); }
    .ag-card-h b { color: var(--fg); font-weight: 600; }

    /* слои агента */
    .ag-layers { display: grid; gap: 0; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
    .ag-layer { display: grid; grid-template-columns: 160px 1fr; gap: 20px; padding: 18px 20px; border-bottom: 1px solid var(--border); background: var(--bg-elevated); }
    .ag-layer:last-child { border-bottom: 0; }
    .ag-layer-t { font-family: 'Manrope', sans-serif; font-weight: 700; color: var(--fg); }
    .ag-layer-d { color: var(--secondary); font-size: 0.94rem; }

    /* интеграции */
    .ag-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
    .ag-chip { font-family: var(--font-mono); font-size: 0.82rem; color: var(--fg); background: var(--bg-elevated); border: 1px solid var(--border-hover); border-radius: 999px; padding: 9px 15px; }
    .ag-note { border-left: 3px solid var(--accent); padding: 4px 0 4px 16px; color: var(--secondary); font-size: 0.95rem; }
    .ag-stop { display: grid; gap: 14px; }
    .ag-stop-item { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; }
    .ag-stop-item svg { color: var(--muted); margin-top: 4px; }
    .ag-stop-item b { color: var(--fg); }

    /* шаги */
    .ag-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; counter-reset: agstep; }
    .ag-step-card { position: relative; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
    .ag-step-card::before { counter-increment: agstep; content: '0' counter(agstep); font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); display: block; margin-bottom: 12px; }
    .ag-step-card h3 { font-family: 'Manrope', sans-serif; font-size: 1.05rem; font-weight: 700; margin: 0 0 8px; }
    .ag-step-card p { color: var(--secondary); font-size: 0.92rem; margin: 0; }

    /* цена */
    .ag-price { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
    .ag-price-card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; }
    .ag-price-card--main { border-color: var(--border-hover); }
    .ag-price-t { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
    .ag-price-v { font-family: 'Manrope', sans-serif; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 10px; }
    .ag-price-d { color: var(--secondary); font-size: 0.92rem; }

    /* читать */
    .ag-read { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .ag-read a { display: grid; gap: 6px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-decoration: none; transition: border-color var(--transition); }
    .ag-read a:hover { border-color: var(--border-hover); }
    .ag-read span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; }
    .ag-read b { font-family: 'Manrope', sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: -0.01em; }
    .ag-read i { font-style: normal; color: var(--secondary); font-size: 0.88rem; }

    @media (max-width: 900px) {
      .ag-hero-layout { grid-template-columns: 1fr; }
      .ag-agent { max-width: 520px; }
      .ag-layer { grid-template-columns: 1fr; gap: 6px; }
    }
</style>

  <!-- ===== ГЕРОЙ ===== -->
  <section class="section ag-hero" id="main-content">
    <div class="container">
      <div class="ag-hero-layout">
        <div>
          <p class="label fade-in">AI-направление · ИИ-агенты</p>
          <h1 class="ag-title fade-in fade-in-d1">
            ИИ-агенты для бизнеса:<br>
            <span class="text-accent">разработка и внедрение</span>
          </h1>
          <p class="text-secondary ag-lead fade-in fade-in-d2">
            Агент — это не чат, который «красиво отвечает». Это исполнитель в вашем процессе:
            находит данные, обновляет CRM, готовит документ, а человек подтверждает результат.
            Собираем под конкретный процесс, а не «внедряем ИИ вообще».
          </p>
          <div class="ag-actions fade-in fade-in-d3">
            <a href="#contacts" class="btn btn-primary btn-shimmer">
              Обсудить задачу
              <svg width="18" height="18"><use href="/icons.svg#icon-arrow-right"/></svg>
            </a>
            <a href="/blog/chto-takoe-ii-agent.html" class="btn btn-outline">Что такое ИИ-агент</a>
          </div>
        </div>

        <aside class="ag-agent fade-in fade-in-d3" aria-label="Как проходит один цикл работы агента">
          <div class="ag-agent-head">
            <span><span class="ag-agent-dot"></span>агент · обработка заявки</span>
            <span>цикл ~2 мин</span>
          </div>
          <div class="ag-agent-body">
            <div class="ag-step">
              <span class="ag-step-n">01</span>
              <div>
                <p class="ag-step-t">Заявка из формы, почты или мессенджера</p>
                <p class="ag-step-d">Агент читает текст, определяет тип и срочность</p>
              </div>
            </div>
            <div class="ag-step">
              <span class="ag-step-n">02</span>
              <div>
                <p class="ag-step-t">Ищет ответ в вашей базе знаний и CRM</p>
                <p class="ag-step-d">Со ссылкой на источник и историей клиента</p>
              </div>
            </div>
            <div class="ag-step">
              <span class="ag-step-n">03</span>
              <div>
                <p class="ag-step-t">Готовит черновик ответа и карточку сделки</p>
                <p class="ag-step-d">Часть шагов — в CRM: статус, задача, напоминание</p>
              </div>
            </div>
            <div class="ag-step">
              <span class="ag-step-n">04</span>
              <div>
                <p class="ag-step-t">Менеджер проверяет и отправляет</p>
                <p class="ag-step-d">Решение остаётся за человеком</p>
              </div>
            </div>
          </div>
          <div class="ag-agent-foot">Схема одного цикла. Что именно делает агент у вас — определяем на аудите процесса.</div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ===== 01: ЧЕМ ОТЛИЧАЕТСЯ ===== -->
  <section class="section section-alt section-border-top" id="chem-otlichaetsya">
    <div class="container container-narrow">
      <p class="label ag-sec-label"><span class="ag-sec-num">01</span>Разница</p>
      <h2 class="ag-h2">Что такое ИИ-агент и чем он <em>отличается</em> от чат-бота</h2>
      <p class="text-secondary ag-sub">
        Три инструмента решают разные задачи, и путаница между ними стоит денег:
        за чат-бота платят как за агента, а ждут от кнопочного сценария поведения специалиста.
      </p>

      <div class="ag-table-wrap">
        <table class="ag-table">
          <thead>
            <tr>
              <th scope="col">Критерий</th>
              <th scope="col">Кнопочный бот</th>
              <th scope="col">Чат с нейросетью</th>
              <th scope="col">ИИ-агент</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Нестандартный запрос</td>
