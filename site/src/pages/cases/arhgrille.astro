---
// Сгенерировано из legacy/version-4/cases/arhgrille.html (tools/import_legacy.py). Дальше правим здесь.
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
---
<Base
  title={"Arhgrille: от нуля до стабильного потока заказов — Smart Solutions"}
  description={"Как исследование аудитории и сегментация помогли производителю декоративных решёток выйти на 1.8М ₽ за 3 месяца и расти 5 лет подряд."}
  path="/cases/arhgrille.html"
  ogDescription={"B2B-кейс: сегментация аудитории, 3 сценария на сайте, 5 лет сопровождения. Подробный разбор."}
  ogType="article"
  active="projects"
  effects
>
  <section class="section section-hero services-hero" id="main-content">
    <div class="hero-decoration">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
    </div>
    <div class="container">
      <div class="case-hero-content">
        <div class="case-hero-tags">
          <span class="case-hero-tag">B2B</span>
          <span class="case-hero-tag">Исследование</span>
          <span class="case-hero-tag">Сопровождение</span>
        </div>
        <h1 class="hero-title fade-in">
          Arhgrille
        </h1>
        <p class="hero-subtitle fade-in fade-in-d1">
          Декоративные вентиляционные решётки премиум-класса
        </p>
        <div class="case-hero-metric fade-in fade-in-d2">
          <span class="case-hero-metric-val">5 лет</span>
          <span class="case-hero-metric-lbl">сопровождения</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== О КЛИЕНТЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">О клиенте</p>
      <h2>Производство решёток премиум-класса</h2>
      <div class="case-about-text">
        <p class="text-secondary">
          Arhgrille — производство и установка декоративных вентиляционных решёток
          из металла под ключ. Премиум-сегмент: архитектурные объекты, дизайнерские
          интерьеры, жилые комплексы.
        </p>
        <p class="text-secondary">
          На момент обращения в 2018 году компания была в начале пути: несколько
          человек, минимальный поток заказов, сильная конкуренция. Конкуренты
          с большими бюджетами уже занимали рынок и использовали агрессивные
          методы — вплоть до DDoS-атак на сайты конкурентов.
        </p>
        <p class="text-secondary">
          Задача: выстроить стабильный поток заказов и помочь компании
          вырасти из мастерской в полноценное производство.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== ИССЛЕДОВАНИЕ ===== -->
  <section class="section section-alt section-accent-line">
    <div class="container container-narrow">
      <p class="label label-accent">Исследование</p>
      <h2>Три аудитории — три сценария</h2>
      <p class="text-secondary">
        Начали с глубокого анализа: кто покупает декоративные решётки,
        зачем, и как выбирает поставщика. Оказалось, что за одним продуктом
        стоят совершенно разные клиенты с разными задачами.
      </p>

      <div class="case-research-stats" data-stagger>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">3</span>
          <span class="case-research-lbl">сегмента аудитории</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">10+</span>
          <span class="case-research-lbl">конкурентов изучено</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">3</span>
          <span class="case-research-lbl">сценария на сайте</span>
        </div>
      </div>

      <h3 class="case-section-subtitle">Сегменты и их задачи</h3>
      <div class="case-insights" data-stagger>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">1</span>
          <div>
            <p class="case-insight-title">Застройщики</p>
            <p class="text-secondary">Закупают решётки партиями на объекты. Важны: сроки поставки,
            оптовые цены, сертификаты, опыт работы с крупными объектами. Решение принимает
            снабженец или прораб — им нужна чёткая спецификация и быстрый расчёт.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">2</span>
          <div>
            <p class="case-insight-title">Дизайнеры и архитекторы</p>
            <p class="text-secondary">Ищут нестандартные решения под конкретный проект. Важны:
            каталог форм и покрытий, визуализации в интерьере, возможность кастомизации.
            Выбирают по эстетике и портфолио реализованных объектов.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">3</span>
          <div>
            <p class="case-insight-title">Частные заказчики</p>
            <p class="text-secondary">Делают ремонт в квартире или доме. Важны: понятные цены,
            примеры в реальных интерьерах, замер и установка под ключ. Боятся ошибиться
            с размером и не понимают, зачем платить за «дорогие решётки».</p>
          </div>
        </div>
      </div>

      <div class="case-insight-conclusion">
        <p class="text-secondary">
          <strong>Ключевой вывод:</strong> один продукт — три совершенно разных процесса
          выбора. Сайт, который говорит со всеми одинаково, не убеждает никого.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== РЕШЕНИЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">Решение</p>
      <h2>Сегментированный подход на каждом уровне</h2>
      <p class="text-secondary">
        Вместо одного сайта «для всех» — три сценария, каждый
        адресует задачи и возражения конкретного сегмента.
      </p>

      <div class="case-solutions" data-stagger>
        <div class="case-solution-card" data-stagger-item>
          <h3>Три входные точки</h3>
          <p class="text-secondary">
            Каждый сегмент попадает в свой сценарий: застройщик видит объёмы и сертификаты,
            дизайнер — каталог и визуализации, частный клиент — цены и примеры в интерьерах.
            Одна компания — три разных предложения.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Контекстная реклама по сегментам</h3>
          <p class="text-secondary">
            Вместо общих запросов типа «вентиляционные решётки» — точечные кампании:
            «решётки для ЖК», «декоративные решётки для дизайн-проекта»,
            «решётки на заказ в квартиру». Каждая ведёт на свою посадочную.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>CRM и система продаж</h3>
          <p class="text-secondary">
            Помогли внедрить CRM-систему: автоматический расчёт стоимости,
            воронка от заявки до установки, контроль сроков. Это позволило
            масштабироваться без потери качества обслуживания.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>SEO и отстройка от конкурентов</h3>
          <p class="text-secondary">
            Нашли позиционирование, которое конкуренты не занимали: «декоративные решётки
            как элемент архитектуры, а не просто вентиляция». Это изменило контент,
            семантику и привлекло именно тех клиентов, которые готовы платить за премиум.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== РЕЗУЛЬТАТЫ ===== -->
  <section class="section section-alt section-glow section-glow-green">
    <div class="container container-narrow">
      <p class="label">Результаты</p>
      <h2>Первые 3 месяца</h2>

      <div class="case-results-grid case-results-grid--three" data-stagger>
        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">~0</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">49</span>
          </div>
          <p class="case-result-name">Заявок / мес</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">0</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">8</span>
          </div>
          <p class="case-result-name">Крупных клиентов</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">0 ₽</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Ноябрь 2018</span>
            <span class="case-result-val case-result-val--accent">1.87M ₽</span>
          </div>
          <p class="case-result-name">Выручка</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ДОЛГОСРОЧНОЕ СОПРОВОЖДЕНИЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">Сопровождение</p>
      <h2>5 лет роста вместе</h2>
      <div class="case-about-text">
        <p class="text-secondary">
          После запуска мы не ушли. Arhgrille стала клиентом на сопровождении —
          и за 5 лет компания выросла из небольшой мастерской в полноценное производство.
        </p>
        <p class="text-secondary">
          Мы помогали на каждом этапе: обновляли сайт под новые линейки продукции,
          масштабировали рекламные кампании, дорабатывали CRM-систему, адаптировали
          стратегию под рост компании.
        </p>
      </div>

      <div class="case-timeline" data-stagger>
        <div class="case-timeline-item" data-stagger-item>
          <span class="case-timeline-year">2018</span>
          <div>
            <p class="case-timeline-title">Старт</p>
            <p class="text-secondary">Исследование, сегментация, запуск сайта и рекламы. Первые заказы за 1 месяц.</p>
          </div>
        </div>
        <div class="case-timeline-item" data-stagger-item>
          <span class="case-timeline-year">2019</span>
          <div>
            <p class="case-timeline-title">Рост</p>
            <p class="text-secondary">Стабильный поток заказов. Расширение каталога, новые линейки. Внедрение CRM.</p>
          </div>
        </div>
        <div class="case-timeline-item" data-stagger-item>
          <span class="case-timeline-year">2020-21</span>
          <div>
            <p class="case-timeline-title">Масштабирование</p>
            <p class="text-secondary">Расширение производства, рост команды. Обновление сайта, новые рекламные каналы.</p>
          </div>
        </div>
        <div class="case-timeline-item" data-stagger-item>
          <span class="case-timeline-year">2022-23</span>
          <div>
            <p class="case-timeline-title">Зрелость</p>
            <p class="text-secondary">Устоявшийся бизнес с полным портфелем заказов. Работа расписана на месяцы вперёд.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ВЫВОД ===== -->
  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="case-conclusion">
        <h2>Почему это сработало</h2>
        <p class="text-secondary">
          Arhgrille продаёт один продукт трём разным аудиториям. Сайт, который
          говорит со всеми одинаково, не убеждает никого. Сегментация позволила
          говорить с каждым клиентом на его языке: застройщику — про сроки и объёмы,
          дизайнеру — про эстетику, частнику — про цены и установку.
        </p>
        <p class="text-secondary">
          Но главное — это не разовый проект, а сопровождение. Мы не сдали сайт
          и ушли. Мы росли вместе с компанией 5 лет: от первых заказов до полной
          загрузки производства. Именно так работает долгосрочное сотрудничество.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section id="contacts" class="section section-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Хотите такой же результат?</h2>
        <p class="text-secondary cta-subtitle">
          Расскажите о вашем проекте — обсудим, как исследование и сопровождение помогут вашему бизнесу.
        </p>
        <ContactCards />
      </div>
    </div>
  </section>
</Base>
