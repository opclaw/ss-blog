---
// Сгенерировано из legacy/version-4/cases/cnd-store.html (tools/import_legacy.py). Дальше правим здесь.
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
---
<Base
  title={"CND-Store: +340% ROI рекламы — Smart Solutions"}
  description={"Как исследование аудитории и редизайн интернет-магазина косметики увеличили ROI рекламы с 80% до 340%."}
  path="/cases/cnd-store.html"
  ogDescription={"Исследование + редизайн = рост выручки на 10М ₽/мес. Подробный разбор проекта."}
  ogType="article"
  active="projects"
  effects
>
  <section class="section section-hero services-hero" id="main-content">
    <div class="hero-decoration">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
    </div>
    <div class="container">
      <div class="case-hero-content">
        <div class="case-hero-tags">
          <span class="case-hero-tag">E-commerce</span>
          <span class="case-hero-tag">Исследование</span>
          <span class="case-hero-tag">Редизайн</span>
        </div>
        <h1 class="hero-title fade-in">
          CND-Store
        </h1>
        <p class="hero-subtitle fade-in fade-in-d1">
          Интернет-магазин американской косметики для ногтей
        </p>
        <div class="case-hero-metric fade-in fade-in-d2">
          <span class="case-hero-metric-val">+340%</span>
          <span class="case-hero-metric-lbl">ROI рекламы</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== О КЛИЕНТЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">О клиенте</p>
      <h2>Интернет-магазин профессиональной косметики</h2>
      <div class="case-about-text">
        <p class="text-secondary">
          CND-Store — интернет-магазин, специализирующийся на американской профессиональной
          косметике для ногтей бренда CND (Creative Nail Design). Продукция включает гель-лаки
          Shellac, системы для наращивания, средства для ухода за ногтями и руками.
        </p>
        <p class="text-secondary">
          Магазин работал, приносил заявки, но рекламные кампании показывали низкий ROI — 80%.
          Каждый вложенный рубль в рекламу возвращал всего 1.80 ₽. Средний чек был ниже рыночного,
          конверсия сайта — 1.2%. Клиент понимал, что потенциал есть, но не знал, где именно теряются покупатели.
        </p>
        <p class="text-secondary">
          Главный вопрос: почему при хорошем продукте и стабильном трафике
          магазин не растёт?
        </p>
      </div>
    </div>
  </section>

  <!-- ===== ИССЛЕДОВАНИЕ ===== -->
  <section class="section section-alt section-accent-line">
    <div class="container container-narrow">
      <p class="label label-accent">Исследование</p>
      <h2>Что мы узнали</h2>
      <p class="text-secondary">
        Прежде чем менять сайт, мы провели полноценное исследование:
        интервью с покупателями, анализ конкурентов, изучение пути клиента.
      </p>

      <div class="case-research-stats" data-stagger>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">30+</span>
          <span class="case-research-lbl">интервью с покупателями</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">15</span>
          <span class="case-research-lbl">конкурентов обзвонено</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">4</span>
          <span class="case-research-lbl">сегмента аудитории</span>
        </div>
      </div>

      <h3 class="case-section-subtitle">Ключевые инсайты</h3>
      <div class="case-insights" data-stagger>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">1</span>
          <div>
            <p class="case-insight-title">Состав важнее цены</p>
            <p class="text-secondary">70% покупателей выбирают косметику по составу и безопасности
            ингредиентов, а не по цене. Старый сайт делал акцент на скидках.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">2</span>
          <div>
            <p class="case-insight-title">Страх подделки</p>
            <p class="text-secondary">Главное возражение — «а вдруг не оригинал?». Покупатели
            боялись получить подделку или просроченный товар. Нужны гарантии подлинности.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">3</span>
          <div>
            <p class="case-insight-title">Повторные покупки через 3-4 недели</p>
            <p class="text-secondary">Цикл использования продукции — 3-4 недели. Значит, нужно
            напоминание о повторной покупке и подписочная модель.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">4</span>
          <div>
            <p class="case-insight-title">Мастера — ключевая аудитория</p>
            <p class="text-secondary">Большинство покупателей — мастера маникюра, которые закупают
            оптом. Для них важны объёмные скидки и быстрая доставка.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== РЕШЕНИЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">Решение</p>
      <h2>Как инсайты изменили сайт</h2>
      <p class="text-secondary">
        На основе исследования мы перестроили структуру, контент и checkout
        интернет-магазина. Каждое изменение адресовало конкретный инсайт.
      </p>

      <div class="case-solutions" data-stagger>
        <div class="case-solution-card" data-stagger-item>
          <h3>Позиционирование на основе JTBD</h3>
          <p class="text-secondary">
            Вместо «скидки и акции» — «оригинальная американская косметика с сертификатами».
            Акцент на безопасности состава, подлинности и профессиональном качестве.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Редизайн карточки товара</h3>
          <p class="text-secondary">
            Добавили: состав на видном месте, сертификат подлинности, срок годности,
            отзывы мастеров. Убрали: агрессивные баннеры и отвлекающие попапы.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Оптимизация checkout</h3>
          <p class="text-secondary">
            Сократили оформление с 5 шагов до 2. Добавили быстрый повторный заказ
            для мастеров. Результат: конверсия корзины выросла на 65%.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Сегментация для мастеров</h3>
          <p class="text-secondary">
            Отдельный раздел с оптовыми ценами, калькулятором расхода и быстрым повторным
            заказом. Автоматическое напоминание через 3 недели после покупки.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== РЕЗУЛЬТАТЫ ===== -->
  <section class="section section-alt section-glow section-glow-green">
    <div class="container container-narrow">
      <p class="label">Результаты</p>
      <h2>Цифры после запуска</h2>

      <div class="case-results-grid" data-stagger>
        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">80%</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">340%</span>
          </div>
          <p class="case-result-name">ROI рекламы</p>
          <p class="case-result-growth">x4.25</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">2 800 ₽</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">3 900 ₽</span>
          </div>
          <p class="case-result-name">Средний чек</p>
          <p class="case-result-growth">+40%</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">1.2%</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">2.8%</span>
          </div>
          <p class="case-result-name">Конверсия сайта</p>
          <p class="case-result-growth">x2.3</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">2M ₽</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--accent">12M ₽</span>
          </div>
          <p class="case-result-name">Выручка / мес</p>
          <p class="case-result-growth">+10M ₽</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ВЫВОД ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <div class="case-conclusion">
        <h2>Почему это сработало</h2>
        <p class="text-secondary">
          Мы не угадывали, что нужно покупателям — мы спросили их напрямую.
          Исследование показало, что клиенты CND-Store выбирают не по цене,
          а по доверию к подлинности продукта. Это изменило всю стратегию:
          от позиционирования до оформления карточки товара.
        </p>
        <p class="text-secondary">
          Сайт стал говорить на языке покупателей. Отвечать на их настоящие
          вопросы. Снимать реальные сомнения. Результат — рост по всем метрикам.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section id="contacts" class="section section-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Хотите такой же результат?</h2>
        <p class="text-secondary cta-subtitle">
          Расскажите о вашем проекте — обсудим, как исследование поможет вашему бизнесу.
        </p>
        <ContactCards />
      </div>
    </div>
  </section>
</Base>
