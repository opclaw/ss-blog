---
// Сгенерировано из legacy/version-4/cases/moya-planeta.html (tools/import_legacy.py). Дальше правим здесь.
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
const jsonLd = [
  "{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://smartsolutions.today/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Проекты\", \"item\": \"https://smartsolutions.today/#projects\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Кейс «Моя Планета»\", \"item\": \"https://smartsolutions.today/cases/moya-planeta.html\"}]}",
];
---

<Base
  jsonLd={jsonLd}
  title={"Моя Планета: x33 рост трафика — Smart Solutions"}
  description={"Как контент-стратегия и структурная оптимизация увеличили трафик портала о путешествиях в 33 раза до 1 млн посетителей в месяц."}
  path="/cases/moya-planeta.html"
  ogDescription={"Контент-стратегия + SEO = 1 млн посетителей/мес. Подробный разбор проекта."}
  ogType="article"
  active="projects"
  effects
>
  <section class="section section-hero services-hero" id="main-content">
    <div class="hero-decoration">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
    </div>
    <div class="container">
      <div class="case-hero-content">
        <div class="case-hero-tags">
          <span class="case-hero-tag">Медиа</span>
          <span class="case-hero-tag">Контент-стратегия</span>
          <span class="case-hero-tag">SEO</span>
        </div>
        <h1 class="hero-title fade-in">
          Моя Планета
        </h1>
        <p class="hero-subtitle fade-in fade-in-d1">
          Портал о путешествиях и географии (проект ВГТРК)
        </p>
        <div class="case-hero-metric fade-in fade-in-d2">
          <span class="case-hero-metric-val">&times;33</span>
          <span class="case-hero-metric-lbl">рост трафика</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== О КЛИЕНТЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">О клиенте</p>
      <h2>Медиа-портал о путешествиях</h2>
      <div class="case-about-text">
        <p class="text-secondary">
          «Моя Планета» — медиа-портал телеканала ВГТРК о путешествиях, географии
          и культуре. Контент — статьи, фоторепортажи, видео о путешествиях по России и миру.
        </p>
        <p class="text-secondary">
          Портал имел качественный контент от редакции телеканала, но трафик
          оставался низким. Статьи не попадали в поисковую выдачу, структура сайта
          не способствовала индексации, а пользователи быстро покидали страницы.
        </p>
        <p class="text-secondary">
          Задача: вывести портал на 1 миллион посетителей в месяц,
          сохранив редакционное качество контента.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== ИССЛЕДОВАНИЕ ===== -->
  <section class="section section-alt section-accent-line">
    <div class="container container-narrow">
      <p class="label label-accent">Исследование</p>
      <h2>Что мы узнали</h2>
      <p class="text-secondary">
        Перед изменениями провели анализ текущего состояния:
        структура, контент, поведение пользователей, поисковая видимость.
      </p>

      <div class="case-research-stats" data-stagger>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">500+</span>
          <span class="case-research-lbl">страниц проанализировано</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">12</span>
          <span class="case-research-lbl">конкурентов изучено</span>
        </div>
        <div class="case-research-stat" data-stagger-item>
          <span class="case-research-num">50K+</span>
          <span class="case-research-lbl">поисковых запросов</span>
        </div>
      </div>

      <h3 class="case-section-subtitle">Ключевые инсайты</h3>
      <div class="case-insights" data-stagger>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">1</span>
          <div>
            <p class="case-insight-title">Контент не оптимизирован под поиск</p>
            <p class="text-secondary">Редакционные заголовки были креативными, но не содержали
            ключевых слов. Статья «Там, где вечно пахнет мандаринами» — это про Абхазию,
            но поисковик этого не понимал.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">2</span>
          <div>
            <p class="case-insight-title">Плоская структура сайта</p>
            <p class="text-secondary">Все статьи лежали в одном разделе без категоризации
            по странам, темам, типам путешествий. Поисковые роботы не могли выстроить
            семантическую карту сайта.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">3</span>
          <div>
            <p class="case-insight-title">Нет внутренней перелинковки</p>
            <p class="text-secondary">Статьи не ссылались друг на друга. Пользователь приходил,
            читал одну статью и уходил. Глубина просмотра — 1.2 страницы.</p>
          </div>
        </div>
        <div class="case-insight" data-stagger-item>
          <span class="case-insight-num">4</span>
          <div>
            <p class="case-insight-title">Огромный нереализованный потенциал</p>
            <p class="text-secondary">Конкуренты с худшим контентом получали в 10-50 раз больше
            трафика за счёт SEO-структуры. Контент «Моей Планеты» был объективно лучше,
            но невидим для поиска.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== РЕШЕНИЕ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">Решение</p>
      <h2>Контент-стратегия + структура + SEO</h2>
      <p class="text-secondary">
        Мы не переписывали контент — он уже был отличным.
        Мы изменили то, как сайт организован и как подаёт этот контент поисковикам и читателям.
      </p>

      <div class="case-solutions" data-stagger>
        <div class="case-solution-card" data-stagger-item>
          <h3>Иерархическая структура</h3>
          <p class="text-secondary">
            Создали категории по странам, регионам и темам. Каждая категория — отдельный
            хаб со своими подборками, картой и навигацией. Глубина вложенности: страна &rarr;
            регион &rarr; тема.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>SEO-оптимизация контента</h3>
          <p class="text-secondary">
            Добавили SEO-заголовки рядом с редакционными: h1 для поиска, визуальный заголовок
            для читателя. Прописали meta-описания, alt-теги для фото, микроразметку статей.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Система перелинковки</h3>
          <p class="text-secondary">
            Автоматические блоки «Читайте также» по теме и географии. Карта-навигация
            по регионам. Тематические подборки. Глубина просмотра выросла с 1.2 до 3.8 страниц.
          </p>
        </div>
        <div class="case-solution-card" data-stagger-item>
          <h3>Техническая оптимизация</h3>
          <p class="text-secondary">
            Ускорение загрузки страниц, оптимизация изображений, корректная
            индексация, XML-карта сайта, AMP-версии ключевых статей.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== РЕЗУЛЬТАТЫ ===== -->
  <section class="section section-alt section-glow section-glow-green">
    <div class="container container-narrow">
      <p class="label">Результаты</p>
      <h2>Цифры после запуска</h2>

      <div class="case-results-grid" data-stagger>
        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">~30K</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--green">1M</span>
          </div>
          <p class="case-result-name">Посетителей / мес</p>
          <p class="case-result-growth">x33</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">1.2</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--green">3.8</span>
          </div>
          <p class="case-result-name">Глубина просмотра</p>
          <p class="case-result-growth">x3.2</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">82%</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--green">45%</span>
          </div>
          <p class="case-result-name">Показатель отказов</p>
          <p class="case-result-growth">-37 пп.</p>
        </div>

        <div class="case-result-card" data-stagger-item>
          <div class="case-result-before">
            <span class="case-result-label">Было</span>
            <span class="case-result-val">~200</span>
          </div>
          <div class="case-result-arrow">
            <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
          </div>
          <div class="case-result-after">
            <span class="case-result-label">Стало</span>
            <span class="case-result-val case-result-val--green">5 000+</span>
          </div>
          <p class="case-result-name">Запросов в топ-10</p>
          <p class="case-result-growth">x25</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ВЫВОД ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <div class="case-conclusion">
        <h2>Почему это сработало</h2>
        <p class="text-secondary">
          У «Моей Планеты» был главный актив — качественный редакционный контент
          от команды телеканала. Проблема была не в содержании, а в структуре
          и видимости. Контент был как книга без оглавления в библиотеке без каталога.
        </p>
        <p class="text-secondary">
          Мы не улучшали контент — мы сделали его находимым. Правильная структура,
          SEO-оптимизация и перелинковка превратили архив статей в живой портал,
          который сам привлекает аудиторию из поиска.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section id="contacts" class="section section-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Хотите такой же результат?</h2>
        <p class="text-secondary cta-subtitle">
          Расскажите о вашем проекте — обсудим, как исследование поможет вашему бизнесу.
        </p>
        <ContactCards />
      </div>
    </div>
  </section>
</Base>
