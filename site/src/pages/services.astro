---
// Сгенерировано из legacy/version-4/services.html (tools/import_legacy.py). Дальше правим здесь.
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
const jsonLd = [
  "{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://smartsolutions.today/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Услуги и цены\", \"item\": \"https://smartsolutions.today/services.html\"}]}",
];
---

<Base
  jsonLd={jsonLd}
  title={"Услуги и цены — Smart Solutions"}
  description={"Системы привлечения клиентов для бизнеса. От лендинга до интернет-магазина. Сопровождение и рост после запуска."}
  path="/services.html"
  ogDescription={"Системы привлечения клиентов: исследование, сайт, реклама, аналитика. От 200 000 ₽."}
  active="services"
  effects
>
  <section class="section section-hero services-hero" id="main-content">
    <div class="hero-decoration">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
    </div>
    <div class="container">
      <div class="services-hero-content">
        <p class="label fade-in">Услуги и цены</p>
        <h1 class="hero-title fade-in fade-in-d1">
          От разового проекта<br>
          <span class="text-accent">до долгосрочного роста.</span>
        </h1>
        <p class="hero-subtitle fade-in fade-in-d2">
          Выстраиваем системы привлечения клиентов на основе данных.
          После запуска помогаем расти: аналитика, доработки, реклама.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== ПУТЬ КЛИЕНТА ===== -->
  <section class="section section-border-top">
    <div class="container">
      <div class="services-path" data-stagger>
        <div class="services-path-step tilt" data-stagger-item>
          <span class="services-path-num">1</span>
          <h3>Проект</h3>
          <p class="services-path-price">от 200 000 ₽</p>
          <p class="text-secondary">Исследование, дизайн, разработка, запуск</p>
        </div>
        <div class="services-path-arrow">
          <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
        </div>
        <div class="services-path-step tilt" data-stagger-item>
          <span class="services-path-num">2</span>
          <h3>Сопровождение</h3>
          <p class="services-path-price">от 50 000 ₽/мес</p>
          <p class="text-secondary">Поддержка, аналитика, доработки, реклама</p>
        </div>
        <div class="services-path-arrow">
          <svg width="24" height="24"><use href="/icons.svg#icon-arrow-right"/></svg>
        </div>
        <div class="services-path-step tilt" data-stagger-item>
          <span class="services-path-num">3</span>
          <h3>Партнёрство</h3>
          <p class="services-path-price">индивидуально</p>
          <p class="text-secondary">Фикс + процент от результата</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== БЛОК: ПРОЕКТ ===== -->
  <section class="section section-alt section-accent-line">
    <div class="container">
      <div class="section-header">
        <p class="label label-accent">Проект под ключ</p>
        <h2>Исследование &rarr; Дизайн &rarr; Разработка &rarr; Запуск</h2>
        <p class="text-secondary">
          Каждый проект начинается с изучения вашего рынка, конкурентов
          и клиентов. Сайт строится на данных, а не догадках.
        </p>
      </div>

      <div class="services-includes" data-stagger>
        <div class="services-include-card" data-stagger-item>
          <h3>Исследование</h3>
          <p class="services-include-time">2-3 недели</p>
          <ul class="services-include-list">
            <li>До 60 интервью с клиентами</li>
            <li>Обзвон 20+ конкурентов</li>
            <li>Карта аудитории и позиционирование</li>
            <li>Прототип на основе данных</li>
          </ul>
        </div>
        <div class="services-include-card" data-stagger-item>
          <h3>Дизайн</h3>
          <p class="services-include-time">2-3 недели</p>
          <ul class="services-include-list">
            <li>UI/UX на основе исследования</li>
            <li>Адаптивный дизайн</li>
            <li>2 раунда правок</li>
          </ul>
        </div>
        <div class="services-include-card" data-stagger-item>
          <h3>Разработка</h3>
          <p class="services-include-time">2-3 недели</p>
          <ul class="services-include-list">
            <li>Адаптивная вёрстка</li>
            <li>Интеграция с CRM</li>
            <li>Настройка аналитики</li>
          </ul>
        </div>
        <div class="services-include-card" data-stagger-item>
          <h3>Запуск</h3>
          <p class="services-include-time">1-2 недели</p>
          <ul class="services-include-list">
            <li>Тестирование</li>
            <li>Запуск рекламы (опционально)</li>
            <li>Первые заявки</li>
          </ul>
        </div>
      </div>

      <!-- Типы проектов -->
      <div class="services-types">
        <h3 class="services-types-title">Типы проектов</h3>
        <div class="services-types-grid" data-stagger>
          <div class="services-type-card tilt" data-stagger-item>
            <h4>Лендинг</h4>
            <p class="services-type-duration">4-6 недель</p>
            <p class="services-type-price">от 200 000 ₽</p>
          </div>
          <div class="services-type-card tilt" data-stagger-item>
            <h4>Корпоративный сайт</h4>
            <p class="services-type-duration">6-10 недель</p>
            <p class="services-type-price">от 400 000 ₽</p>
          </div>
          <div class="services-type-card tilt" data-stagger-item>
            <h4>Интернет-магазин</h4>
            <p class="services-type-duration">8-12 недель</p>
            <p class="services-type-price">от 600 000 ₽</p>
          </div>
          <div class="services-type-card tilt" data-stagger-item>
            <h4>Портал / сервис</h4>
            <p class="services-type-duration">12+ недель</p>
            <p class="services-type-price">от 1 000 000 ₽</p>
          </div>
        </div>
      </div>

      <div class="guarantee-box glow-pulse-green">
        <div class="guarantee-icon">
          <svg width="24" height="24"><use href="/icons.svg#icon-shield-check"/></svg>
        </div>
        <div>
          <p class="guarantee-title">Остаёмся рядом</p>
          <p class="text-secondary">
            Поддержка после запуска включена.
            Средний срок работы с клиентом — 3+ года.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== БЛОК: СОПРОВОЖДЕНИЕ ===== -->
  <section class="section section-border-top section-glow section-glow-green">
    <div class="container">
      <div class="section-header">
        <p class="label">Сопровождение</p>
        <h2>Не бросаем после сдачи.<br>Помогаем расти.</h2>
        <p class="text-secondary">
          Стабильный поток заявок, аналитика и оптимизация.
          Не нужно искать подрядчиков на каждую задачу.
        </p>
      </div>

      <div class="services-packages" data-stagger>
        <div class="services-package-card tilt" data-stagger-item>
          <div class="services-package-badge">Базовое</div>
          <p class="services-package-price">от 50 000 <span>₽/мес</span></p>
          <ul class="services-package-list">
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Техническая поддержка сайта
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Мелкие доработки (до 10 часов/мес)
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Ежемесячный отчёт по аналитике
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Рекомендации по улучшению конверсии
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Приоритетная связь (ответ в течение 4 часов)
            </li>
          </ul>
          <a href="#contacts" class="btn btn-outline services-package-btn">Обсудить</a>
        </div>

        <div class="services-package-card services-package-featured tilt" data-stagger-item>
          <div class="services-package-badge services-package-badge-accent">Расширенное</div>
          <p class="services-package-price">от 100 000 <span>₽/мес</span></p>
          <ul class="services-package-list">
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Всё из базового пакета
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Ведение контекстной рекламы (Яндекс.Директ)
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              A/B-тестирование
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Базовое SEO
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Идентификация анонимных посетителей
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              Ежемесячная стратегическая сессия (1 час)
            </li>
            <li>
              <svg width="16" height="16"><use href="/icons.svg#icon-check"/></svg>
              До 20 часов доработок/мес
            </li>
          </ul>
          <a href="#contacts" class="btn btn-primary btn-shimmer services-package-btn">Обсудить</a>
        </div>
      </div>

      <div class="services-how-works">
        <h3>Как работает сопровождение</h3>
        <div class="services-how-steps" data-stagger>
          <div class="services-how-step" data-stagger-item>
            <span class="services-how-num">1</span>
            <p>Фиксированная оплата в начале месяца</p>
          </div>
          <div class="services-how-step" data-stagger-item>
            <span class="services-how-num">2</span>
            <p>Выделенный менеджер на связи</p>
          </div>
          <div class="services-how-step" data-stagger-item>
            <span class="services-how-num">3</span>
            <p>Доступ к дашборду с метриками</p>
          </div>
          <div class="services-how-step" data-stagger-item>
            <span class="services-how-num">4</span>
            <p>Ежемесячный отчёт и созвон</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== МЯГКОЕ УПОМИНАНИЕ ПАРТНЁРСТВА ===== -->
  <section class="section section-alt section-pattern">
    <div class="container container-narrow">
      <div class="services-partnership-note">
        <h2>Партнёрство: растём вместе</h2>
        <p class="text-secondary">
          Для клиентов, с которыми сработались на сопровождении,
          предлагаем модель партнёрства: фиксированная часть + процент
          от результата. Мы инвестируем своё время в ваш рост и зарабатываем,
          когда растёте вы.
        </p>
        <p class="text-muted services-partnership-condition">
          Партнёрство обсуждается индивидуально после 6+ месяцев сопровождения.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ПО УСЛУГАМ ===== -->
  <section class="section section-border-top">
    <div class="container container-narrow">
      <p class="label">FAQ</p>
      <h2>Вопросы по услугам</h2>

      <div class="faq-list" id="faqList">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="sfaq-0">
            <span>Можно начать с проекта без сопровождения?</span>
            <svg class="faq-icon" width="20" height="20"><use href="/icons.svg#icon-chevron-down"/></svg>
          </button>
          <div class="faq-answer" id="sfaq-0" role="region">
            <p>Да, большинство клиентов так и делают. Сопровождение — следующий шаг для тех, кто хочет продолжить рост.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="sfaq-1">
            <span>Что если сопровождение не приносит результата?</span>
            <svg class="faq-icon" width="20" height="20"><use href="/icons.svg#icon-chevron-down"/></svg>
          </button>
          <div class="faq-answer" id="sfaq-1" role="region">
            <p>Мы анализируем причины и корректируем стратегию. Если за 3 месяца нет улучшений — расторгаем без штрафов.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="sfaq-2">
            <span>Как вы отчитываетесь?</span>
            <svg class="faq-icon" width="20" height="20"><use href="/icons.svg#icon-chevron-down"/></svg>
          </button>
          <div class="faq-answer" id="sfaq-2" role="region">
            <p>Ежемесячный отчёт: трафик, конверсии, заявки, выполненные задачи. Доступ к дашборду в реальном времени.</p>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="sfaq-3">
            <span>Работаете с рекламным бюджетом?</span>
            <svg class="faq-icon" width="20" height="20"><use href="/icons.svg#icon-chevron-down"/></svg>
          </button>
          <div class="faq-answer" id="sfaq-3" role="region">
            <p>Рекламный бюджет оплачивается отдельно напрямую площадкам. Мы управляем кампаниями, но не накручиваем комиссию на бюджет.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="section section-cta" id="contacts">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Напишите или позвоните</h2>
        <p class="text-secondary cta-subtitle">
          Выберите удобный канал — ответим быстро.
        </p>

        <ContactCards />
      </div>
    </div>
  </section>
</Base>
