{
  "name": "smartsolutions-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "minutes": "node tools/fix-minutes.mjs dist",
    "preview": "astro preview --host 0.0.0.0",
    "verify": "python3 tools/verify.py",
    "check": "astro build && python3 tools/verify.py && python3 tools/make-sitemap.py --check && node tools/js-check.mjs dist && node tools/kit-check.mjs dist && node tools/fix-minutes.mjs dist --check && python3 tools/style-check.py && python3 tools/qa-check.py && python3 tools/seo-audit.py",
    "test:js": "node tools/js-check.mjs dist",
    "test:kit": "node tools/kit-check.mjs dist",
    "sitemap": "python3 tools/make-sitemap.py",
    "audit": "python3 tools/seo-audit.py",
    "qa": "python3 tools/qa-check.py",
    "content": "python3 tools/content-audit.py",
    "style": "python3 tools/style-check.py"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "jsdom": "^30.1.1"
  }
}
